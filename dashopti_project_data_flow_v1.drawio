        <mxCell id="5XQGE1Q0sDRGbxL6DRzS-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;spacing=6;" value="&lt;div style=&quot;white-space: pre-wrap;&quot;&gt;Condition Parameterization&lt;/div&gt;" vertex="1">
