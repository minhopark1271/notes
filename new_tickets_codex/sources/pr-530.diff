--- /dev/null
+++ b/model/DashPipelineStamp.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <QString>
+
+// Pipeline stamp vocabulary (D26) and the D20 block messages. The stamp is written once
+// at creation time (DOE Table → dataset XML → model_info.json); each hop pins the first
+// input's id into its own {Set}.json and blocks any other id afterwards. Every hop uses
+// these keys and the one sentence shape, so they live in one header.
+namespace DashPipelineStamp {
+
+// SI-5 combination id (DashParameterization::derivedId).
+inline constexpr char kParameterizationId[] = "parameterizationId";
+// {uuid, path} of the combination's geometry deck — DashSetReferenceModel::toObject shape.
+inline constexpr char kGeometryDeck[] = "geometryDeck";
+
+inline QString mismatchMessage(const QString& pinnedId)
+{
+    return QStringLiteral("이 Set 은 %1 기준으로 고정되어 있습니다. "
+                          "다른 기준 조합은 새 Set 을 만들어 사용하세요.")
+        .arg(pinnedId);
+}
+
+// D20 re-revision: no fallback for unstamped legacy outputs — block and ask for a rerun.
+inline QString unstampedMessage()
+{
+    return QStringLiteral("스탬프 없는 구산출물입니다. "
+                          "이전 단계를 다시 실행해 만든 산출물을 사용하세요.");
+}
+
+}  // namespace DashPipelineStamp
