+QString DashParameterization::derivedId() const
+{
+    if (geometry.setId.isEmpty()) {
+        return QString();
+    }
+    QStringList conditionIds;
+    for (const Entry& entry : conditions) {
+        if (entry.setId.isEmpty()) {
+            return QString();
+        }
+        conditionIds.append(entry.setId);
+    }
+    std::sort(conditionIds.begin(), conditionIds.end());
+    return geometry.setId + QLatin1Char('+') + conditionIds.join(QLatin1Char(','));
+}
