+
+void DashOptimizer::pinParameterizationId(const QString& id)
+{
+    if (m_setName.isEmpty()) {
+        // Set 미지정 시 경로가 Set1 기본값으로 풀려 엉뚱한 Set 에 핀이 박힌다 — 기록 거부.
+        DASH_LOG_WARN(Optimizer) << "Parameterization pin skipped — no Set context";
+        return;
+    }
+    if (m_optimizationJsonPath.isEmpty()) {
+        return;
+    }
+    QFile file(m_optimizationJsonPath);
+    QJsonObject root;
+    if (file.open(QIODevice::ReadOnly)) {
+        root = QJsonDocument::fromJson(file.readAll()).object();
+        file.close();
+    }
+    root[QLatin1String(DashPipelineStamp::kParameterizationId)] = id;
+    if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        file.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+        file.close();
+    }
+    DASH_LOG_INFO(Optimizer) << "Parameterization pinned:" << id << "→" << m_optimizationJsonPath;
+}
