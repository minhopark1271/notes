+QString DashDataProcessor::pinnedParameterizationId() const
+{
+    DashProjectManager* prjMgr = DashProjectManager::Instance();
+    DashIOController* ioCtrl = prjMgr ? prjMgr->GetIOController() : nullptr;
+    if (!ioCtrl || m_setName.isEmpty()) {
+        // Set 미지정 시 Set1 기본값을 타면 엉뚱한 Set 의 핀을 기준으로 삼는다.
+        return QString();
+    }
+    QFile file(ioCtrl->getConfigFilePath(ModuleType::DataPreprocessor, m_setName));
+    if (!file.open(QIODevice::ReadOnly)) {
+        return QString();
+    }
+    const QJsonObject root = QJsonDocument::fromJson(file.readAll()).object();
+    return root.value(QLatin1String(DashPipelineStamp::kParameterizationId)).toString();
+}
+
+void DashDataProcessor::pinParameterizationId(const QString& id)
+{
+    DashProjectManager* prjMgr = DashProjectManager::Instance();
+    DashIOController* ioCtrl = prjMgr ? prjMgr->GetIOController() : nullptr;
+    if (!ioCtrl) {
+        return;
+    }
+    if (m_setName.isEmpty()) {
+        // Set 미지정 시 Set1 기본값을 타면 엉뚱한 Set 에 핀이 박힌다 — 기록 거부.
+        DASH_LOG_WARN(DataProcessor) << "Parameterization pin skipped — no Set context";
+        return;
+    }
+    QFile file(ioCtrl->getConfigFilePath(ModuleType::DataPreprocessor, m_setName));
+    QJsonObject root;
+    if (file.open(QIODevice::ReadOnly)) {
+        root = QJsonDocument::fromJson(file.readAll()).object();
+        file.close();
+    }
+    root[QLatin1String(DashPipelineStamp::kParameterizationId)] = id;
+    if (file.open(QIODevice::WriteOnly)) {
+        file.write(QJsonDocument(root).toJson());
+        file.close();
+    }
+    DASH_LOG_INFO(DataProcessor) << "Parameterization pinned:" << id << "→" << file.fileName();
+}
