+
+void DashModelBuilder::pinParameterizationId(const QString& id)
+{
+    DashProjectManager* prjMgr = DashProjectManager::Instance();
+    DashIOController* ioCtrl = prjMgr ? prjMgr->GetIOController() : nullptr;
+    if (!ioCtrl) {
+        return;
+    }
+    if (m_setName.isEmpty()) {
+        // Set 미지정 시 Set1 기본값을 타면 엉뚱한 Set 에 핀이 박힌다 — 기록 거부.
+        DASH_LOG_WARN(ModelBuilder) << "Parameterization pin skipped — no Set context";
+        return;
+    }
+    QFile file(ioCtrl->getConfigFilePath(ModuleType::ModelBuilder, m_setName));
+    QJsonObject root;
+    if (file.open(QIODevice::ReadOnly)) {
+        root = QJsonDocument::fromJson(file.readAll()).object();
+        file.close();
+    }
+    root[QLatin1String(DashPipelineStamp::kParameterizationId)] = id;
+    if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        file.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+        file.close();
+    }
+    DASH_LOG_INFO(ModelBuilder) << "Parameterization pinned:" << id << "→" << file.fileName();
+}
