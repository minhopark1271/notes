+    // geometry 단독 조합도 유효한 id 를 낸다 — 조건부는 빈 연접
+    const DashParameterization geometryOnly = DashDoeSelection::makeParameterization(
+        idEntry(QStringLiteral("Geo1"), QStringLiteral("geoid1111111")), {});
+    QCOMPARE(geometryOnly.derivedId(), QStringLiteral("geoid1111111+"));
+}
+
+void TestDoeSelection::derivedIdSortsConditionsBySetIdNotByName()
+{
+    // makeParameterization 은 이름 정렬 — id 는 setId 정렬이어야 이름과 무관하게 멱등이다
+    const DashParameterization combination = DashDoeSelection::makeParameterization(
+        idEntry(QStringLiteral("Geo1"), QStringLiteral("geoid1111111")),
+        { idEntry(QStringLiteral("Aaa"), QStringLiteral("zzz999999999")),
+          idEntry(QStringLiteral("Zzz"), QStringLiteral("aaa111111111")) });
+
+    QCOMPARE(combination.derivedId(),
+             QStringLiteral("geoid1111111+aaa111111111,zzz999999999"));
+}
+
+void TestDoeSelection::derivedIdSurvivesARename()
+{
+    // Set rename 은 setId 를 바꾸지 않으므로 id 도 불변이어야 한다
+    const DashParameterization before = DashDoeSelection::makeParameterization(
+        idEntry(QStringLiteral("Geo1"), QStringLiteral("geoid1111111")),
+        { idEntry(QStringLiteral("Cond1"), QStringLiteral("cond11111111")) });
+
+    const DashParameterization after = DashDoeSelection::makeParameterization(
+        idEntry(QStringLiteral("GeoRenamed"), QStringLiteral("geoid1111111")),
+        { idEntry(QStringLiteral("CondRenamed"), QStringLiteral("cond11111111")) });
+
+    QCOMPARE(after.derivedId(), before.derivedId());
+}
+
+void TestDoeSelection::derivedIdIsEmptyWhenAnySetIdIsMissing()
+{
+    // setId 결손(pre-T29 기록·백필 실패)은 id 미발급 — 하류는 무스탬프로 취급한다
+    const DashParameterization geometryIdless = DashDoeSelection::makeParameterization(
+        entry(QStringLiteral("Geo1"), QStringLiteral("u-geo"), QStringLiteral("a.dat")),
+        { idEntry(QStringLiteral("Cond1"), QStringLiteral("cond11111111")) });
+    QVERIFY(geometryIdless.derivedId().isEmpty());
+
+    const DashParameterization conditionIdless = DashDoeSelection::makeParameterization(
+        idEntry(QStringLiteral("Geo1"), QStringLiteral("geoid1111111")),
+        { entry(QStringLiteral("Cond1"), QStringLiteral("u-c1"), QStringLiteral("a.dat")) });
+    QVERIFY(conditionIdless.derivedId().isEmpty());
+
+    QVERIFY(DashParameterization().derivedId().isEmpty());
+}
+
 QTEST_MAIN(TestDoeSelection)
