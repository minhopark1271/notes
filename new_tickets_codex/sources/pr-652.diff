+void DashDirectLaunchDialog::showEvent(QShowEvent* event)
+{
+    QDialog::showEvent(event);
+    // The run may have moved on, or a project been opened, while the dialog was hidden
+    if (m_outputLineEdit->text().isEmpty()) {
+        m_outputLineEdit->setText(projectFolder());
+    }
+    refreshFromRunner();
+}
+
+void DashDirectLaunchDialog::resetForProject()
+{
+    m_inputLineEdit->clear();
+    fillTargetParts();
+    // The new project's folder, or empty with no project open
+    m_outputLineEdit->setText(projectFolder());
+    m_resultLineEdit->clear();
+    {
+        const QSignalBlocker componentBlocker(m_componentCombo);
+        const QSignalBlocker stepBlocker(m_stepCombo);
+        m_componentCombo->clear();
+        m_stepCombo->clear();
+    }
+    m_nameCombo->clear();
+    m_previewButton->setEnabled(false);
+    refreshFromRunner();
+}
+
+void DashDirectLaunchDialog::setPage(int index)
+{
+    ui->stack->setCurrentIndex(index);
+    ui->stepGroup->button(index)->setChecked(true);
+}
+
+void DashDirectLaunchDialog::onStepClicked(int index)
+{
+    setPage(index);
+    if (index != PagePreview || !m_resultLineEdit->text().isEmpty()) {
+        return;
+    }
+    // First visit: start from the finished case's result, when there is one on disk
+    const QString resultFile = doneCaseResultFile();
+    if (resultFile.isEmpty() || !QFileInfo::exists(resultFile)) {
+        return;
+    }
+    loadResultFile(resultFile);
+}
+
+QString DashDirectLaunchDialog::doneCaseResultFile() const
+{
+    const QList<DashDirectLaunchRunner::Case> cases = m_runner->cases();
+    if (cases.isEmpty() || cases.first().status != QLatin1String("Done")
+        || cases.first().resultFiles.isEmpty()) {
+        return QString();
+    }
+    return cases.first().resultFiles.first();
+}
+
+void DashDirectLaunchDialog::openCasePreview()
+{
+    // Coming from a finished case always shows that case, whatever file was picked before
+    setPage(PagePreview);
+    loadResultFile(doneCaseResultFile());
+}
+
+QString DashDirectLaunchDialog::projectFolder() const
+{
+    return DashManager::PrjMgr()->GetProjectFolderPath();
+}
+
+void DashDirectLaunchDialog::onBrowseInput()
+{
+    const QString path =
+        QFileDialog::getOpenFileName(this,
+                                     tr("Select Input File"),
+                                     projectFolder(),
+                                     tr("Input Files (*.inp *.dat *.dfsxml *.wbpj)"));
+    if (path.isEmpty()) {
+        return;
+    }
+
+    const QFileInfo picked(path);
+    if (!isInsideFolder(path, projectFolder())) {
+        DashNotify::warning(DashLog::Module::View,
+                            this,
+                            tr("Direct Launch"),
+                            tr("Pick a file inside the project folder."));
+        return;
+    }
+    static const QStringList kInputSuffixes = { "inp", "dat", "dfsxml", "wbpj" };
+    if (!kInputSuffixes.contains(picked.suffix().toLower())) {
+        DashNotify::warning(DashLog::Module::View,
+                            this,
+                            tr("Direct Launch"),
+                            tr("Pick a .inp, .dat, .dfsxml or .wbpj file."));
+        return;
+    }
+
+    m_inputLineEdit->setText(picked.canonicalFilePath());
+    fillTargetParts();
+    updateLauncherButtons();
+}
+
+void DashDirectLaunchDialog::fillTargetParts()
+{
+    const QString input = m_inputLineEdit->text();
+    const bool wbpj = isWbpj(input);
+    m_targetPartLabel->setVisible(wbpj);
+    m_targetPartCombo->setVisible(wbpj);
+    m_targetPartCombo->clear();
+    if (!wbpj) {
+        return;
+    }
+
+    // The .prt files the runner copies with the project: under <base>_files, stored relative
+    // to the .wbpj's folder as DashDirectLaunchRunner::run expects
+    const QFileInfo wbpjInfo(input);
+    const QDir wbpjDir = wbpjInfo.absoluteDir();
+    QDirIterator it(wbpjDir.filePath(wbpjInfo.completeBaseName() + QStringLiteral("_files")),
+                    { QStringLiteral("*.prt") },
+                    QDir::Files,
+                    QDirIterator::Subdirectories);
+    while (it.hasNext()) {
+        m_targetPartCombo->addItem(wbpjDir.relativeFilePath(it.next()));
+    }
+}
+
+void DashDirectLaunchDialog::onSetOutput()
+{
+    const QString dir =
+        QFileDialog::getExistingDirectory(this, tr("Select Output Folder"), projectFolder());
+    if (dir.isEmpty()) {
+        return;
+    }
+    m_outputLineEdit->setText(dir);
+    updateLauncherButtons();
+}
+
+void DashDirectLaunchDialog::onStartClicked()
+{
+    // The project may have changed since the input was picked
+    if (!isInsideFolder(m_inputLineEdit->text(), projectFolder())) {
+        DashNotify::warning(DashLog::Module::View,
+                            this,
+                            tr("Direct Launch"),
+                            tr("The input file is not inside the open project folder."));
+        return;
+    }
+    // Stop on either side cancels the daemons both share, so the runs must not overlap
+    if (DashManager::Mgr()->isLauncherAnalysisRunning()) {
+        DashNotify::warning(DashLog::Module::View,
+                            this,
+                            tr("Direct Launch"),
+                            tr("An analysis is already running in Analysis Launcher."));
+        return;
+    }
+
+    const QString input = m_inputLineEdit->text();
+    const QString output = m_outputLineEdit->text();
+    // Checked before Re-run deletes the run folder, which would take the input with it
+    const QString problem = DashDirectLaunchRunner::stagingProblem(input, output);
+    if (!problem.isEmpty()) {
+        DashNotify::warning(DashLog::Module::View, this, tr("Direct Launch"), problem);
+        return;
+    }
+
+    QDir runDir(DashDirectLaunchStaging::runDirOf(input, output));
+    if (runDir.exists() && !runDir.isEmpty()) {
+        QMessageBox box(QMessageBox::Question,
+                        tr("Existing results"),
+                        tr("%1 already exists. Run again (the folder is deleted first)?")
+                            .arg(QDir::toNativeSeparators(runDir.absolutePath())),
+                        QMessageBox::NoButton,
+                        this);
+        QPushButton* rerunButton = box.addButton(tr("Re-run"), QMessageBox::DestructiveRole);
+        QPushButton* cancelButton = box.addButton(tr("Cancel"), QMessageBox::RejectRole);
+        box.setDefaultButton(cancelButton);
+        box.setEscapeButton(cancelButton);
+        box.exec();
+        if (box.clickedButton() != rerunButton) {
+            return;
+        }
+        DASH_LOG_INFO(View) << "Direct Launch: removing previous run folder"
+                            << runDir.absolutePath();
+        runDir.removeRecursively();
+    }
+
+    DashManager::Mgr()->setCPUCoreCount(static_cast<unsigned int>(m_cpuCoresSpinBox->value()));
+    const QString targetPart = isWbpj(input) ? m_targetPartCombo->currentText() : QString();
+    const QString error = m_runner->run(input, output, targetPart);
+    if (error.isEmpty()) {
+        return;
+    }
+    DashNotify::warning(DashLog::Module::View, this, tr("Direct Launch"), error);
+}
+
+void DashDirectLaunchDialog::refreshFromRunner()
+{
+    const QList<DashDirectLaunchRunner::Case> cases = m_runner->cases();
+    m_casesTable->setRowCount(static_cast<int>(cases.size()));
+    for (int row = 0; row < cases.size(); ++row) {
+        const DashDirectLaunchRunner::Case& c = cases.at(row);
+        m_casesTable->setItem(row, kColCase, new QTableWidgetItem(c.key));
+        auto* statusItem = new QTableWidgetItem(c.status);
+        statusItem->setIcon(getStatusIcon(c.status));
+        statusItem->setTextAlignment(Qt::AlignCenter);
+        m_casesTable->setItem(row, kColStatus, statusItem);
+        m_casesTable->setItem(row, kColLog, new QTableWidgetItem(c.log));
+    }
+
+    m_statusLabel->setText(cases.isEmpty() ? QString() : statusLineOf(cases.first()));
+    m_casePreviewButton->setEnabled(!doneCaseResultFile().isEmpty());
+    updateLauncherButtons();
+}
+
+void DashDirectLaunchDialog::updateLauncherButtons()
+{
+    const bool running = m_runner->isRunning();
+    const QString input = m_inputLineEdit->text();
+    const bool targetReady = !isWbpj(input) || m_targetPartCombo->currentIndex() >= 0;
+    // Re-read on show and on the runner's signals only; Start refuses a Launcher run begun since
+    m_startButton->setEnabled(DashManager::PrjMgr()->IsProjectOpen()
+                              && !DashManager::Mgr()->isAnyAnalysisRunning() && !input.isEmpty()
+                              && !m_outputLineEdit->text().isEmpty() && targetReady);
+    m_stopButton->setEnabled(running);
+}
+
+void DashDirectLaunchDialog::onBrowseResult()
+{
+    const QString path = QFileDialog::getOpenFileName(this,
+                                                      tr("Select Result File"),
+                                                      m_outputLineEdit->text(),
+                                                      tr("Result Files (*.rst *.dfr *.odb)"));
+    if (path.isEmpty()) {
+        return;
+    }
+    loadResultFile(path);
+}
+
+void DashDirectLaunchDialog::loadResultFile(const QString& path)
+{
+    m_resultLineEdit->setText(QDir::toNativeSeparators(path));
+    {
+        const QSignalBlocker componentBlocker(m_componentCombo);
+        const QSignalBlocker stepBlocker(m_stepCombo);
+        m_componentCombo->clear();
+        m_stepCombo->clear();
+    }
+    m_nameCombo->clear();
+    m_previewButton->setEnabled(false);
+    m_resultModel->loadSingleResultFile(QFileInfo(path).absoluteFilePath());
+}
+
+void DashDirectLaunchDialog::onKeysExtracted(const ExtractedKeys& keys)
+{
+    {
+        // Filled silently: each index change would read the catalog once more
+        const QSignalBlocker componentBlocker(m_componentCombo);
+        const QSignalBlocker stepBlocker(m_stepCombo);
+        m_componentCombo->clear();
+        m_componentCombo->addItems(keys.components);
+        m_stepCombo->clear();
+        for (const QString& step : DashResultChoiceFlatten::loadStepLeaves(keys.loadSteps)) {
+            m_stepCombo->addItem(step, step);
+        }
+    }
+    // A modal file reports its names before its keys as well as after; the later report wins
+    m_nameCombo->clear();
+    m_previewButton->setEnabled(false);
+    onComponentChanged();
+}
+
+void DashDirectLaunchDialog::onNamesUpdated(const QMap<QString, QStringList>& names)
+{
+    m_nameCombo->clear();
+    for (const QString& name : DashResultChoiceFlatten::nameLeaves(names)) {
+        m_nameCombo->addItem(name, name);
+    }
+    m_previewButton->setEnabled(m_nameCombo->count() > 0);
+}
+
+void DashDirectLaunchDialog::onComponentChanged()
+{
+    const QString component = m_componentCombo->currentText();
+    // Function expressions do not depend on the time step
+    const bool functionExpression = component == kFunctionExpression;
+    m_stepCombo->setEnabled(!functionExpression);
+    if (!functionExpression) {
+        m_resultModel->requestVtkGeometry(component);
+    }
+    requestNames();
+}
+
+void DashDirectLaunchDialog::requestNames()
+{
+    m_nameCombo->clear();
+    m_previewButton->setEnabled(false);
+    const QString component = m_componentCombo->currentText();
+    if (component == kFunctionExpression) {
+        m_resultModel->onSelectionChanged(component, QString());
+        return;
+    }
+    if (m_stepCombo->currentIndex() < 0) {
+        return;
+    }
+    m_resultModel->onSelectionChanged(component, m_stepCombo->currentData().toString());
+}
+
+void DashDirectLaunchDialog::onPreviewClicked()
+{
+    const QString component = m_componentCombo->currentText();
+    const QString step =
+        component == kFunctionExpression ? QString() : m_stepCombo->currentData().toString();
+    const QString name = m_nameCombo->currentData().toString();
+    m_previewDisplayName = DashResultChoiceFlatten::previewScalarName(step, name);
+    m_resultModel->requestVtkPreview(component, step, name);
+}
