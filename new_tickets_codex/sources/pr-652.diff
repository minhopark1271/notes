+// Unit tests for model/preprocessor/DashResultChoiceFlatten (#604): the load step and name trees
+// flattened to the strings the Direct Launch Result Preview combos pass to the reader. Level: all
+// Level 1 — no files, processes or event loop.
+
+#include <QtTest/QtTest>
+#include "TestLevel.h"
+#include "model/preprocessor/DashResultChoiceFlatten.h"
+
+namespace {
+
+// All Level 1 — nothing to list for Push / Ci (docs/test-levels.md section 7).
+const DashTestLevel::Table testLevels{};
+
+}  // namespace
+
+class TestResultChoiceFlatten : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void init();
+
+    void joinsStepsAndSubstepsInNumericOrder();
+    void keepsABareStepWithoutSubsteps();
+    void takesModesAndStatesAsIs();
+    void collapsesTheMagnitudeToTheMainName();
+    void keepsModeShapeSubNames();
+    void buildsThePreviewScalarName();
+};
+
+void TestResultChoiceFlatten::init()
+{
+    const QString reason = DashTestLevel::skipReasonIfAny(
+        testLevels, QString::fromLatin1(QTest::currentTestFunction()));
+    if (!reason.isEmpty()) {
+        QSKIP(qPrintable(reason));
+    }
+}
+
+void TestResultChoiceFlatten::joinsStepsAndSubstepsInNumericOrder()
+{
+    QMap<QString, QList<QString>> loadSteps;
+    loadSteps["Step 10"] = { "Substep 1" };
+    loadSteps["Step 2"] = { "Substep 10", "Substep 2" };
+
+    QCOMPARE(DashResultChoiceFlatten::loadStepLeaves(loadSteps),
+             QStringList({ "Step 2 / Substep 2", "Step 2 / Substep 10", "Step 10 / Substep 1" }));
+}
+
+void TestResultChoiceFlatten::keepsABareStepWithoutSubsteps()
+{
+    QMap<QString, QList<QString>> loadSteps;
+    loadSteps["Step 1"] = {};
+
+    QCOMPARE(DashResultChoiceFlatten::loadStepLeaves(loadSteps), QStringList({ "Step 1" }));
+}
+
+void TestResultChoiceFlatten::takesModesAndStatesAsIs()
+{
+    QMap<QString, QList<QString>> modal;
+    modal["Modes"] = { "Mode 10", "Mode 2", "Mode 1" };
+    QCOMPARE(DashResultChoiceFlatten::loadStepLeaves(modal),
+             QStringList({ "Mode 1", "Mode 2", "Mode 10" }));
+
+    QMap<QString, QList<QString>> motion;
+    motion["States"] = { "State 2", "State 1" };
+    QCOMPARE(DashResultChoiceFlatten::loadStepLeaves(motion),
+             QStringList({ "State 1", "State 2" }));
+}
+
+void TestResultChoiceFlatten::collapsesTheMagnitudeToTheMainName()
+{
+    QMap<QString, QStringList> names;
+    names["Displacement"] = { "X", "Y", "_" };
+    names["Stress"] = { "_" };
+    names["Natural Frequency"] = {};
+
+    QCOMPARE(DashResultChoiceFlatten::nameLeaves(names),
+             QStringList({ "Displacement / X",
+                           "Displacement / Y",
+                           "Displacement",
+                           "Natural Frequency",
+                           "Stress" }));
+}
+
+void TestResultChoiceFlatten::keepsModeShapeSubNames()
+{
+    // modeShapeLeaf reads the lowercase sub name, so it must arrive intact
+    QMap<QString, QStringList> names;
+    names["Mode Shape"] = { "x", "magnitude" };
+
+    QCOMPARE(DashResultChoiceFlatten::nameLeaves(names),
+             QStringList({ "Mode Shape / x", "Mode Shape / magnitude" }));
+}
+
+void TestResultChoiceFlatten::buildsThePreviewScalarName()
+{
+    QCOMPARE(DashResultChoiceFlatten::previewScalarName("Step 1 / Substep 2", "Stress / XX"),
+             QString("Step_1_Substep_2_Stress_XX"));
+    QCOMPARE(DashResultChoiceFlatten::previewScalarName("Mode 3", "Mode Shape / magnitude"),
+             QString("Mode_3_Mode_Shape"));
+    QCOMPARE(DashResultChoiceFlatten::previewScalarName("Step 1 / Substep 1", "Displacement"),
+             QString("Step_1_Substep_1_Displacement"));
+    QCOMPARE(DashResultChoiceFlatten::previewScalarName(QString(), "Function Expression / f1"),
+             QString("_Function_Expression_f1"));
+}
+
+QTEST_GUILESS_MAIN(TestResultChoiceFlatten)
+#include "TestResultChoiceFlatten.moc"
