-void DashDoeSamplerDirectWidget::removeInputCaseRow()
-{
-    if (!m_inputCasesTable) {
-        return;
-    }
-
-    int currentRow = m_inputCasesTable->currentRow();
-    if (currentRow < 0) {
-        return;
-    }
-
-    // Get file name before removing
-    QString fileName;
-    auto* fileWidget = qobject_cast<QWidget*>(m_inputCasesTable->cellWidget(currentRow, 0));
-    if (fileWidget) {
-        auto* fileLayout = qobject_cast<QHBoxLayout*>(fileWidget->layout());
-        if (fileLayout && fileLayout->count() > 0) {
-            auto* fileEdit = qobject_cast<QLineEdit*>(fileLayout->itemAt(0)->widget());
-            if (fileEdit) {
-                fileName = fileEdit->text();
-            }
-        }
-    }
-
-    // Clean up .wbpj target mapping if present
-    if (!fileName.isEmpty()) {
-        m_directTargetFiles.remove(fileName);
-    }
-
-    m_inputCasesTable->removeRow(currentRow);
-
-    syncInputCasesToOutputCases();
-}
