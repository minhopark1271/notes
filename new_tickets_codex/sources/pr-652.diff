diff --git a/model/preprocessor/DashResultChoiceFlatten.h b/model/preprocessor/DashResultChoiceFlatten.h
new file mode 100644
index 00000000..e8530d3d
--- /dev/null
+++ b/model/preprocessor/DashResultChoiceFlatten.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <QList>
+#include <QMap>
+#include <QString>
+#include <QStringList>
+
+#include <algorithm>
+
+// The load step and name trees of a loaded result file flattened to single-level choices, each
+// string exactly what DashAnalysisLauncher::onSelectionChanged / requestVtkPreview accept, for
+// pickers that are a combo box rather than a tree (Direct Launch Result Preview, #604). Pure
+// functions, Qt Core only.
+namespace DashResultChoiceFlatten {
+
+// Steps, substeps, modes and states sort by their numeric last token, as the Launcher's tree does
+inline void sortByNumericLastToken(QStringList& labels)
+{
+    std::sort(labels.begin(), labels.end(), [](const QString& a, const QString& b) {
+        return a.section(' ', -1).toInt() < b.section(' ', -1).toInt();
+    });
+}
+
+// ExtractedKeys::loadSteps flattened to leaves. "Modes" and "States" contribute their children
+// as is ("Mode 1", "State 1"); any other step contributes "Step N / Substep M" per substep, or
+// the bare "Step N" when it has none (accepted for Abaqus only, as the tree's top-level pick is).
+inline QStringList loadStepLeaves(const QMap<QString, QList<QString>>& loadSteps)
+{
+    QStringList stepKeys = loadSteps.keys();
+    sortByNumericLastToken(stepKeys);
+    QStringList leaves;
+    for (const QString& stepKey : stepKeys) {
+        QStringList children = loadSteps.value(stepKey);
+        sortByNumericLastToken(children);
+        if (stepKey == QLatin1String("Modes") || stepKey == QLatin1String("States")) {
+            leaves.append(children);
+            continue;
+        }
+        if (children.isEmpty()) {
+            leaves.append(stepKey);
+            continue;
+        }
+        for (const QString& child : children) {
+            leaves.append(stepKey + QStringLiteral(" / ") + child);
+        }
+    }
+    return leaves;
+}
+
+// namesUpdated's map flattened to leaves. A main name with no sub names, or only "_", is a leaf
+// itself; otherwise each sub name gives "Main / sub", where "_" (the magnitude) collapses to the
+// main name.
+inline QStringList nameLeaves(const QMap<QString, QStringList>& names)
+{
+    QStringList leaves;
+    for (auto it = names.constBegin(); it != names.constEnd(); ++it) {
+        const QString& mainName = it.key();
+        const QStringList& subNames = it.value();
+        if (subNames.isEmpty()
+            || (subNames.size() == 1 && subNames.first() == QLatin1String("_"))) {
+            leaves.append(mainName);
+            continue;
+        }
+        for (const QString& subName : subNames) {
+            leaves.append(subName == QLatin1String("_")
+                              ? mainName
+                              : mainName + QStringLiteral(" / ") + subName);
+        }
+    }
+    return leaves;
+}
+
+// Spaces and slashes to underscores, so a step or name reads as one token
+inline QString makeSafe(const QString& text)
+{
+    QString safe = text;
+    safe.replace(QStringLiteral(" / "), QStringLiteral("_"));
+    safe.replace(QLatin1Char('/'), QLatin1Char('_'));
+    safe.replace(QLatin1Char(' '), QLatin1Char('_'));
+    return safe;
+}
+
+// The scalar name the central view shows for a preview: makeSafe(step) + "_" + makeSafe(name),
+// with a "Magnitude" sub name (any case, e.g. Mode Shape's "magnitude") shown as its main name
+inline QString previewScalarName(const QString& loadStep, const QString& name)
+{
+    QString displayName = name;
+    const int separator = name.indexOf(QStringLiteral(" / "));
+    if (separator >= 0
+        && name.mid(separator + 3).compare(QLatin1String("Magnitude"), Qt::CaseInsensitive) == 0) {
+        displayName = name.left(separator);
+    }
+    return makeSafe(loadStep) + QLatin1Char('_') + makeSafe(displayName);
+}
+
+}  // namespace DashResultChoiceFlatten
