+DashDirectLaunchDialog* DashMainWindow::ensureDirectLaunchDialog()
+{
+    if (m_directLaunchDialog) {
+        return m_directLaunchDialog;
+    }
+    m_directLaunchDialog = new DashDirectLaunchDialog(this);
+
+    // Result Preview draws in the central view, as the Analysis Launcher's Preview does
+    DashAnalysisLauncher* resultModel = m_directLaunchDialog->resultModel();
+    auto* renderMgr = DashManager::Mgr()->GetRenderingManager();
+    connect(
+        resultModel, &DashAnalysisLauncher::processingStarted, this, [this](const QString& msg) {
+            showLoadingIndicator(true);
+            showStatusMessage(msg, 0);
+        });
+    connect(resultModel, &DashAnalysisLauncher::processingFinished, this, [this]() {
+        showLoadingIndicator(false);
+        showStatusMessage(tr("Done."), 2000);
+    });
+    connect(resultModel,
+            &DashAnalysisLauncher::allGeometryReady,
+            renderMgr,
+            &DashRenderingManager::updateAllGeometry);
+    connect(resultModel,
+            &DashAnalysisLauncher::componentGeometryReady,
+            renderMgr,
+            &DashRenderingManager::updateComponentGeometry);
+    connect(resultModel,
+            &DashAnalysisLauncher::fieldOutputReady,
+            this,
+            [this](vtkSmartPointer<vtkUnstructuredGrid> grid) {
+                showFieldOutput(grid, m_directLaunchDialog->previewDisplayName());
+            });
+    return m_directLaunchDialog;
+}
+
+void DashMainWindow::showFieldOutput(vtkSmartPointer<vtkUnstructuredGrid> grid,
+                                     const QString& displayName)
+{
+    auto* renderMgr = DashManager::Mgr()->GetRenderingManager();
+    QString scalarName = "Result";
+    double minVal = 0.0, maxVal = 1.0;
+    // Point scalars, else cell scalars: the order updateFieldOutput looks the name up in
+    vtkDataArray* scalars = grid->GetPointData()->GetScalars();
+    if (!scalars) {
+        scalars = grid->GetCellData()->GetScalars();
+    }
+    if (scalars) {
+        if (!displayName.isEmpty()) {
+            scalarName = displayName;
+            scalars->SetName(scalarName.toUtf8().constData());
+        } else {
+            scalarName = scalars->GetName();
+        }
+        double range[2];
+        scalars->GetRange(range);
+        minVal = range[0];
+        maxVal = range[1];
+    }
+    if (!renderMgr->updateFieldOutput(grid, scalarName)) {
+        // Without the requested array only the geometry is drawn: say there are no values (#493)
+        DashNotify::warning(DashLog::Module::Rendering,
+                            this,
+                            tr("Preview"),
+                            tr("No '%1' values to display. The arrays in "
+                               "the result are listed in the log.")
+                                .arg(scalarName));
+    }
+    if (m_viewOptionsWidget) {
+        m_viewOptionsWidget->setColorBarRange(minVal, maxVal);
+    }
+}
+
+void DashMainWindow::onDirectLaunch()
+{
+    DashDirectLaunchDialog* dialog = ensureDirectLaunchDialog();
+    dialog->show();
+    dialog->raise();
+    dialog->activateWindow();
+}
