+    m_statusLabel = ui->statusLabel;
+    m_resultLineEdit = ui->resultLineEdit;
+    m_componentCombo = ui->componentCombo;
+    m_stepCombo = ui->stepCombo;
+    m_nameCombo = ui->nameCombo;
+    m_previewButton = ui->previewButton;
+
+    ui->stepGroup->setId(ui->stepLauncher, PageLauncher);
+    ui->stepGroup->setId(ui->stepPreview, PagePreview);
+    connect(ui->stepGroup, &QButtonGroup::idClicked, this, &DashDirectLaunchDialog::onStepClicked);
+
+    m_targetPartLabel->setVisible(false);
+    m_targetPartCombo->setVisible(false);
+    m_outputLineEdit->setText(projectFolder());
+    m_cpuCoresSpinBox->setValue(static_cast<int>(DashManager::Mgr()->getCPUCoreCount()));
+    m_casesTable->setColumnWidth(kColCase, 160);
+    m_casesTable->setColumnWidth(kColStatus, 90);
+    m_casePreviewButton->setEnabled(false);
+    m_previewButton->setEnabled(false);
+
+    connect(
+        ui->inputBrowseButton, &QPushButton::clicked, this, &DashDirectLaunchDialog::onBrowseInput);
+    connect(ui->outputSetButton, &QPushButton::clicked, this, &DashDirectLaunchDialog::onSetOutput);
+    connect(m_targetPartCombo,
+            QOverload<int>::of(&QComboBox::currentIndexChanged),
+            this,
+            &DashDirectLaunchDialog::updateLauncherButtons);
+    connect(m_startButton, &QPushButton::clicked, this, &DashDirectLaunchDialog::onStartClicked);
