diff --git a/tests/TestDirectLaunchStaging.cpp b/tests/TestDirectLaunchStaging.cpp
new file mode 100644
index 00000000..564d20a1
--- /dev/null
+++ b/tests/TestDirectLaunchStaging.cpp
@@ -0,0 +1,99 @@
+// Unit tests for controller/DashDirectLaunchStaging (#604): where a Direct Launch run is staged and
+// the refusal of an input that already lives inside its own run folder. Level: all Level 1 — a
+// temporary folder only, no processes or event loop.
+
+#include <QDir>
+#include <QFile>
+#include <QTemporaryDir>
+#include <QtTest/QtTest>
+#include "TestLevel.h"
+#include "controller/DashDirectLaunchStaging.h"
+
+namespace {
+
+// All Level 1 — nothing to list for Push / Ci (docs/test-levels.md section 7).
+const DashTestLevel::Table testLevels{};
+
+// Creates an empty file at root/relativePath, with its folders, and returns its path
+QString touch(const QString& root, const QString& relativePath)
+{
+    const QString path = QDir(root).filePath(relativePath);
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QFile file(path);
+    // Opening for writing creates the file; it stays empty
+    [[maybe_unused]] const bool created = file.open(QIODevice::WriteOnly);
+    return path;
+}
+
+}  // namespace
+
+class TestDirectLaunchStaging : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void init();
+
+    void runDirIsTheCompleteBaseNameUnderTheOutputRoot();
+    void acceptsAnInputOutsideARunFolderNotCreatedYet();
+    void catchesAnInputInsideItsRunFolder();
+    void comparesCanonicalPaths();
+    void ignoresASiblingFolderSharingThePrefix();
+};
+
+void TestDirectLaunchStaging::init()
+{
+    const QString reason = DashTestLevel::skipReasonIfAny(
+        testLevels, QString::fromLatin1(QTest::currentTestFunction()));
+    if (!reason.isEmpty()) {
+        QSKIP(qPrintable(reason));
+    }
+}
+
+void TestDirectLaunchStaging::runDirIsTheCompleteBaseNameUnderTheOutputRoot()
+{
+    QCOMPARE(DashDirectLaunchStaging::runDirOf("C:/project/decks/model.v2.inp", "C:/project/out"),
+             QString("C:/project/out/model.v2"));
+}
+
+void TestDirectLaunchStaging::acceptsAnInputOutsideARunFolderNotCreatedYet()
+{
+    QTemporaryDir dir;
+    const QString input = touch(dir.path(), "model.inp");
+    // <root>/model does not exist yet, as on a file's first run
+    QVERIFY(!DashDirectLaunchStaging::inputInsideRunDir(input, dir.path()));
+}
+
+void TestDirectLaunchStaging::catchesAnInputInsideItsRunFolder()
+{
+    QTemporaryDir dir;
+    const QString input = touch(dir.path(), "out/model/model.inp");
+    QVERIFY(DashDirectLaunchStaging::inputInsideRunDir(input, QDir(dir.path()).filePath("out")));
+    // Deeper inside the run folder counts as well
+    const QString nested = touch(dir.path(), "out/model/sub/model.inp");
+    QVERIFY(DashDirectLaunchStaging::inputInsideRunDir(nested, QDir(dir.path()).filePath("out")));
+}
+
+void TestDirectLaunchStaging::comparesCanonicalPaths()
+{
+    QTemporaryDir dir;
+    const QString input = touch(dir.path(), "out/model/model.inp");
+    touch(dir.path(), "out/other/keep.txt");
+    // The same output root spelled through a detour
+    const QString outputRoot = QDir(dir.path()).filePath("out/other/..");
+    QVERIFY(DashDirectLaunchStaging::inputInsideRunDir(input, outputRoot));
+    const QString detouredInput = QDir(dir.path()).filePath("out/other/../model/model.inp");
+    QVERIFY(DashDirectLaunchStaging::inputInsideRunDir(detouredInput,
+                                                       QDir(dir.path()).filePath("out")));
+}
+
+void TestDirectLaunchStaging::ignoresASiblingFolderSharingThePrefix()
+{
+    QTemporaryDir dir;
+    // The run folder of model.inp is <root>/model, not <root>/modelB
+    const QString input = touch(dir.path(), "modelB/model.inp");
+    QVERIFY(!DashDirectLaunchStaging::inputInsideRunDir(input, dir.path()));
+}
+
+QTEST_GUILESS_MAIN(TestDirectLaunchStaging)
+#include "TestDirectLaunchStaging.moc"
