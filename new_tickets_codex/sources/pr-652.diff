+const QString kFunctionExpression = QStringLiteral("Function Expression");
+
+// Compared on canonical paths, so a path through a link or in another case still counts
+bool isInsideFolder(const QString& path, const QString& folder)
+{
+    const QString folderPrefix = QFileInfo(folder).canonicalFilePath() + QLatin1Char('/');
+    return QFileInfo(path).canonicalFilePath().startsWith(folderPrefix, Qt::CaseInsensitive);
+}
+
+bool isWbpj(const QString& path)
+{
+    return QFileInfo(path).suffix().compare(QLatin1String("wbpj"), Qt::CaseInsensitive) == 0;
+}
+
+// The bottom status line for the run's one case
+QString statusLineOf(const DashDirectLaunchRunner::Case& c)
+{
+    if (c.status == QLatin1String("Done") || c.status == QLatin1String("Cancelled")) {
+        return c.status;
+    }
+    if (c.status.startsWith(QLatin1String("Failed"))) {
+        return QStringLiteral("Failed");
+    }
+    return QStringLiteral("Running %1%2").arg(c.key, QChar(0x2026));
+}
