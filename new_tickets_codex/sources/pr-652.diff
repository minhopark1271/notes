-void DashDoeSamplerDirectWidget::browseInputCaseFile(int row)
-{
-    if (!m_inputCasesTable) {
-        return;
-    }
-
-    QStringList filePaths = QFileDialog::getOpenFileNames(
-        this, "Select Input Files", "", "Input Files (*.dat *.inp *.dfsxml *.wbpj);;All Files (*)");
-    if (filePaths.isEmpty()) {
-        return;
-    }
-
-    bool firstFile = true;
-    int currentRow = row;
-
-    for (const QString& filePath : filePaths) {
-        if (!firstFile) {
-            addInputCaseRow();
-            currentRow = m_inputCasesTable->rowCount() - 1;
-        }
-        firstFile = false;
-
-        auto* fileWidget = qobject_cast<QWidget*>(m_inputCasesTable->cellWidget(currentRow, 0));
-        if (!fileWidget) {
-            continue;
-        }
-        auto* fileLayout = qobject_cast<QHBoxLayout*>(fileWidget->layout());
-        if (!fileLayout || fileLayout->count() == 0) {
-            continue;
-        }
-        auto* fileEdit = qobject_cast<QLineEdit*>(fileLayout->itemAt(0)->widget());
-        if (!fileEdit) {
-            continue;
-        }
-
-        fileEdit->setText(filePath);
-
-        // For .wbpj, immediately prompt for the required .prt target file
-        const QString suffix = QFileInfo(filePath).suffix().toLower();
-        if (suffix == "wbpj") {
-            QString prtPath = QFileDialog::getOpenFileName(
-                this,
-                QString("Select .prt target for %1").arg(QFileInfo(filePath).fileName()),
-                QFileInfo(filePath).absolutePath(),
-                "NX Part Files (*.prt);;All Files (*)");
-            if (prtPath.isEmpty()) {
-                QMessageBox::warning(
-                    this,
-                    "Target Required",
-                    ".wbpj workflow requires a .prt target file. The entry has been removed.");
-                m_inputCasesTable->removeRow(currentRow);
-                continue;
-            }
-            m_directTargetFiles[filePath] = prtPath;
-        }
-
-        // Update Solver State based on file extension
-        auto* stateItem = m_inputCasesTable->item(currentRow, 1);
-        if (stateItem) {
-            QString solverState = "Not Set";
-            QBrush textColor(QColor{ DashPalette::Error });
-            if (auto* mgr = DashManager::Mgr()) {
-                bool configured = false;
-                if (suffix == "inp") {
-                    configured = !mgr->getSolverPath("Abaqus").isEmpty();
-                } else if (suffix == "wbpj") {
-                    configured = !mgr->getSolverPath("Ansys").isEmpty()
-                                 && !mgr->getSolverPath("NX").isEmpty();
-                } else {  // .dat, .dfsxml
-                    configured = !mgr->getSolverPath("Ansys").isEmpty();
-                }
-                if (configured) {
-                    solverState = "Set";
-                    textColor = QBrush(Qt::darkGreen);
-                }
-            }
-            stateItem->setText(solverState);
-            stateItem->setForeground(textColor);
-        }
-    }
-
-    syncInputCasesToOutputCases();
-}
-
-void DashDoeSamplerDirectWidget::syncInputCasesToOutputCases()
-{
-    if (!m_directOutputCasesWidget || !m_inputCasesTable) {
-        return;
-    }
-
-    // Get all file paths from input cases table
-    QStringList inputFilePaths = getInputCaseFilePaths();
-
-    // Use public method to update Direct Launcher's output cases
-    m_directOutputCasesWidget->setDirectLauncherCases(inputFilePaths);
-}
-
-QStringList DashDoeSamplerDirectWidget::getInputCaseFilePaths() const
-{
-    QStringList filePaths;
-
-    if (!m_inputCasesTable) {
-        return filePaths;
-    }
-
-    for (int row = 0; row < m_inputCasesTable->rowCount(); ++row) {
-        auto* fileWidget = qobject_cast<QWidget*>(m_inputCasesTable->cellWidget(row, 0));
-        if (!fileWidget) {
-            continue;
-        }
-
-        auto* fileLayout = qobject_cast<QHBoxLayout*>(fileWidget->layout());
-        if (!fileLayout || fileLayout->count() == 0) {
-            continue;
-        }
-
-        auto* fileEdit = qobject_cast<QLineEdit*>(fileLayout->itemAt(0)->widget());
-        if (!fileEdit) {
-            continue;
-        }
-
-        QString filePath = fileEdit->text();
-        if (!filePath.isEmpty()) {
-            filePaths.append(filePath);
-        }
-    }
-
-    return filePaths;
-}
