+void DashAnalysisLauncher::loadSingleResultFile(const QString& absPath)
+{
+    if (rejectIfReaderBusy("load the result file")) {
+        return;
+    }
+    clearLoadedContext();
+
+    beginProcessing(tr("Reading result file..."));
+    const auto endIndicator = qScopeGuard([this] { endProcessing(); });
+    QApplication::processEvents(QEventLoop::ExcludeUserInputEvents);
+
+    const QFileInfo fileInfo(absPath);
+    const QString fileName = fileInfo.fileName();
+    // loadResultKeys reads only the dataset items whose type equals the type it is given
+    QString type = DashTargetFiles::analysisTypeOf(fileName);
+    if (fileInfo.suffix().compare("rst", Qt::CaseInsensitive) == 0) {
+        // The probe reader is discarded on leaving this scope; loadResultKeys makes its own (#573)
+        ReaderWork probeWork(readerSession_, ReaderWork::OnExit::Discard);
+        if (initializePreprocessor("rst")) {
+            try {
+                reader()->SetInputFilePathes({ std::filesystem::path(absPath.toStdWString()) });
+                if (const auto analysis =
+                        DashResultKeys::analysisTypeOf(reader()->GetAnalysisInfo())) {
+                    type = *analysis;
+                }
+            } catch (const std::exception& e) {
+                DASH_LOG_WARN(DataProcessor) << "GetAnalysisInfo failed for" << fileName << ":"
+                                             << e.what() << ", using default type:" << type;
+            }
+        }
+    }
+
+    DatasetItem item;
+    item.itemNum = "1";
+    item.type = type;
+    item.path = fileName;
+    item.patternFileName = fileName;
+    item.filePath = QDir::toNativeSeparators(absPath);
+    m_inputs.dataset = { item };
+    DASH_LOG_DEBUG(DataProcessor) << "Loading single result file" << absPath << "as" << type;
+    loadResultKeys(type, QString());
+}
