+{
+    ui->setupUi(this);
+
+    // A tool window over the main window; closing or Esc only hides it and never stops a run.
+    // Hiding leaves the central scene as it is: no hide or close handler touches the renderer.
+    setWindowFlags(Qt::Tool);
+    setModal(false);
+    setSizeGripEnabled(true);
+
+    // zero-churn aliasing: keep member names independent of the .ui object names
+    m_inputLineEdit = ui->inputLineEdit;
+    m_targetPartLabel = ui->targetPartLabel;
+    m_targetPartCombo = ui->targetPartCombo;
+    m_outputLineEdit = ui->outputLineEdit;
