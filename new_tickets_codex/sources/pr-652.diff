-    QPushButton* browseButton = new QPushButton("...");
-    browseButton->setFixedWidth(30);
-    connect(browseButton, &QPushButton::clicked, this, [this, row]() { browseInputCaseFile(row); });
-    fileLayout->addWidget(browseButton);
