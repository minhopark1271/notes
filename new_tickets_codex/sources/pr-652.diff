+++ b/controller/DashDirectLaunchRunner.cpp
@@ -0,0 +1,215 @@
+#include "controller/DashDirectLaunchRunner.h"
+#include "controller/DashDirectLaunchStaging.h"
+
+#include "model/DashAnalysisLaunchExecutor.h"
+#include "model/DashJobRunner.h"
+#include "utils/log/DashLog.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QMap>
+
+namespace {
+bool copyFileOver(const QString& sourcePath, const QString& destPath)
+{
+    QFile::remove(destPath);
+    if (QFile::copy(sourcePath, destPath)) {
+        return true;
+    }
+    DASH_LOG_WARN(Analysis) << "Direct Launch: could not copy" << sourcePath << "to" << destPath;
+    return false;
+}
+
+// Stops at the first file that fails to copy
+bool copyTreeOver(const QString& sourceDir, const QString& destDir)
+{
+    QDir().mkpath(destDir);
+    const QDir source(sourceDir);
+    for (const QFileInfo& entry :
+         source.entryInfoList(QDir::Files | QDir::Dirs | QDir::NoDotAndDotDot | QDir::Hidden)) {
+        const QString destPath = QDir(destDir).filePath(entry.fileName());
+        const bool copied = entry.isDir() ? copyTreeOver(entry.absoluteFilePath(), destPath)
+                                          : copyFileOver(entry.absoluteFilePath(), destPath);
+        if (!copied) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool isTerminalStatus(const QString& status)
+{
+    // startsWith: a refusal reports "Failed: <stage> (<reason>)" and ends the run just as plainly
+    return status == QLatin1String("Done") || status.startsWith(QLatin1String("Failed"))
+           || status == QLatin1String("Cancelled");
+}
+}  // namespace
+
+DashDirectLaunchRunner::DashDirectLaunchRunner(QObject* parent)
+    : QObject(parent)
+    , m_jobRunner(new DashJobRunner(this))
+{
+    connect(m_jobRunner, &DashJobRunner::jobStarted, this, [this] {
+        m_submittedRunSerial = m_activeRunSerial;
+    });
+    // There is one case per run, so any key the runner reports is that case's: a .wbpj run
+    // is keyed by its .prt basename, not by the input file. Reports with no case open (a late
+    // Journal result after Stop) belong to an ended run and are dropped.
+    connect(m_jobRunner,
+            &DashJobRunner::caseStatusUpdated,
+            this,
+            [this](const QString& /*key*/, const QString& status, const QString& analysisType) {
+                onCaseStatusUpdated(status, analysisType);
+            });
+    connect(m_jobRunner,
+            &DashJobRunner::caseLogUpdated,
+            this,
+            [this](const QString& /*key*/, const QString& log, const QString& /*analysisType*/) {
+                if (m_activeRunSerial == 0) {
+                    return;
+                }
+                Case& c = m_cases.first();
+                c.log = log;
+                emit caseLogUpdated(c.key, log);
+            });
+}
+
+QString DashDirectLaunchRunner::stagingProblem(const QString& inputPath, const QString& outputRoot)
+{
+    if (!DashDirectLaunchStaging::inputInsideRunDir(inputPath, outputRoot)) {
+        return QString();
+    }
+    return tr("The input file is inside the output folder.");
+}
+
+QString DashDirectLaunchRunner::run(const QString& inputPath,
+                                    const QString& outputRoot,
+                                    const QString& targetPart)
+{
+    if (isRunning()) {
+        DASH_LOG_WARN(Analysis) << "Direct Launch already running, ignoring duplicate request";
+        return tr("A Direct Launch is already running.");
+    }
+    const QString problem = stagingProblem(inputPath, outputRoot);
+    if (!problem.isEmpty()) {
+        DASH_LOG_WARN(Analysis) << QString("Direct Launch: %1 is inside its run folder under %2")
+                                       .arg(inputPath, outputRoot);
+        return problem;
+    }
+
+    const QFileInfo input(inputPath);
+    const QString key = input.completeBaseName();
+    const QString runDir = DashDirectLaunchStaging::runDirOf(inputPath, outputRoot);
+    const bool wbpj = input.suffix().compare(QLatin1String("wbpj"), Qt::CaseInsensitive) == 0;
+    const QString filesDirName = key + QStringLiteral("_files");
+    const bool runDirExisted = QDir(runDir).exists();
+    QDir().mkpath(runDir);
+    const QString copiedPath = QDir(runDir).filePath(input.fileName());
+    const bool staged = copyFileOver(inputPath, copiedPath)
+                        && (!wbpj
+                            || copyTreeOver(input.dir().filePath(filesDirName),
+                                            QDir(runDir).filePath(filesDirName)));
+    if (!staged) {
+        DASH_LOG_WARN(Analysis) << QString("Direct Launch: staging %1 into %2 failed, not launched")
+                                       .arg(inputPath, runDir);
+        // Only a folder this call created goes; a reused one keeps what it held
+        if (!runDirExisted) {
+            QDir(runDir).removeRecursively();
+        }
+        return tr("Could not copy %1 into %2.")
+            .arg(QDir::toNativeSeparators(inputPath), QDir::toNativeSeparators(runDir));
+    }
+
+    QMap<QString, QString> targetFiles;
+    m_resultDir = runDir;
+    if (wbpj) {
+        // The .prt inside the copy, so the Journal writes beside it, under the run folder
+        const QFileInfo prt(QDir(runDir).filePath(targetPart));
+        targetFiles.insert(copiedPath, prt.absoluteFilePath());
+        m_resultDir = QDir(prt.absolutePath()).filePath(prt.completeBaseName());
+    }
+
+    m_outputRoot = outputRoot;
+    const int serial = ++m_runSerial;
+    m_cases = { Case{ key, inputPath, runDir, QStringLiteral("Enqueued"), QString(), {}, serial } };
+    m_resultsBeforeRun.clear();
+    for (const QString& file : resultCandidates()) {
+        const QFileInfo info(file);
+        if (info.exists()) {
+            m_resultsBeforeRun.insert(file, info.lastModified());
+        }
+    }
+    m_activeRunSerial = serial;
+    emit started();
+    emit caseStatusUpdated(key, m_cases.first().status);
+
+    DASH_LOG_INFO(Analysis) << QString("Direct Launch: %1 -> %2").arg(inputPath, runDir);
+    m_jobRunner->applyLauncherCPUCoreCount();
+    m_jobRunner->runDirectJobs({ copiedPath }, targetFiles);
+
+    // Nothing was submitted (solver not configured, launcher refused, no .prt target): no
+    // status will ever come for the case.
+    if (m_submittedRunSerial != serial) {
+        onCaseStatusUpdated(QStringLiteral("Failed"), QString());
+    }
+    return QString();
+}
+
+void DashDirectLaunchRunner::cancel()
+{
+    m_jobRunner->cancelAllRuns();
+    // A .wbpj case in its NX CAD or Journal stage holds no task to abort and reports nothing,
+    // so the run ends here as the Analysis Launcher's does. A case already ended stays as is.
+    onCaseStatusUpdated(QStringLiteral("Cancelled"), QString());
+}
+
+QStringList DashDirectLaunchRunner::resultCandidates() const
+{
+    const Case& c = m_cases.first();
+    const QString suffix = QFileInfo(c.inputPath).suffix().toLower();
+    // Abaqus names its .odb after the job name, the run key; motion-launcher writes <key>.dfr
+    if (suffix == QLatin1String("inp")) {
+        return { QDir(m_resultDir).filePath(c.key + QStringLiteral(".odb")) };
+    }
+    if (suffix == QLatin1String("dfsxml")) {
+        return { QDir(m_resultDir).filePath(c.key + QStringLiteral(".dfr")) };
+    }
+    // MAPDL names its .rst after the deck's jobname; a Journal project may hold several systems
+    QStringList files;
+    for (const QString& file :
+         DashJobRunner::rstResultFiles(m_resultDir, suffix == QLatin1String("wbpj"))) {
+        files.append(QDir(m_resultDir).filePath(file));
+    }
+    return files;
+}
+
+void DashDirectLaunchRunner::onCaseStatusUpdated(const QString& status, const QString& analysisType)
+{
+    if (m_activeRunSerial == 0) {
+        return;
+    }
+    Case& c = m_cases.first();
+    const QString oldStatus = c.status;
+    c.status = status;
+    if (status == QLatin1String("Done")) {
+        // The run folder is reused by every run of the file: keep only what this one wrote
+        for (const QString& file : resultCandidates()) {
+            const QFileInfo info(file);
+            const auto before = m_resultsBeforeRun.constFind(file);
+            if (info.exists()
+                && (before == m_resultsBeforeRun.constEnd()
+                    || info.lastModified() != before.value())) {
+                c.resultFiles.append(file);
+            }
+        }
+    }
+    DashAnalysisLaunchExecutor::logCaseStatus(c.key, status, analysisType, oldStatus);
+    emit caseStatusUpdated(c.key, status);
+
+    if (!isTerminalStatus(status)) {
+        return;
+    }
+    m_activeRunSerial = 0;
+    emit finished();
+}
diff --git a/controller/DashDirectLaunchRunner.h b/controller/DashDirectLaunchRunner.h
new file mode 100644
index 00000000..879c474b
--- /dev/null
+++ b/controller/DashDirectLaunchRunner.h
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <QDateTime>
+#include <QHash>
+#include <QList>
+#include <QObject>
+#include <QString>
+#include <QStringList>
+
+class DashJobRunner;
+
+/**
+ * @class DashDirectLaunchRunner
+ * @brief Owner of a Direct Launch run (Tool menu): one input file run as is, no DOE.
+ *
+ * `DashManager` owns it, so a run outlives the dialog that started it. The case list lives in
+ * memory only; nothing is written to any json. Status flow follows the Analysis Launcher
+ * (DashAnalysisLaunchExecutor) without its case-state persistence.
+ */
+class DashDirectLaunchRunner : public QObject
+{
+    Q_OBJECT
+
+public:
+    struct Case
+    {
+        QString key;  // the input file's completeBaseName
+        QString inputPath;  // the file the user picked
+        QString runDir;  // <outputRoot>/<key>, holding the copy that is launched
+        QString status;
+        QString log;
+        QStringList resultFiles;  // absolute paths this run wrote, set at Done
+        int runSerial = 0;  // the run() call that opened the case
+    };
+
+    explicit DashDirectLaunchRunner(QObject* parent = nullptr);
+
+    QList<Case> cases() const
+    {
+        return m_cases;
+    }
+    bool isRunning() const
+    {
+        return m_activeRunSerial != 0;
+    }
+    QString outputRoot() const
+    {
+        return m_outputRoot;
+    }
+
+    // Copies inputPath into <outputRoot>/<completeBaseName>/ (a .wbpj also takes its sibling
+    // <completeBaseName>_files folder) and launches the copy, so the solver writes into that
+    // run folder. targetPart is the .prt path relative to the .wbpj's directory, empty for
+    // other inputs. Returns an empty string once launched, else why it was refused: a run is
+    // in progress (Stop cancels the shared NX CAD / Journal daemons), stagingProblem() has an
+    // answer, or a copy failed (a run folder created by this call is removed again).
+    QString run(const QString& inputPath, const QString& outputRoot, const QString& targetPart);
+    // Why inputPath cannot be staged under outputRoot, checked before anything is copied or
+    // deleted; empty when it can. The input must not live inside its own run folder.
+    static QString stagingProblem(const QString& inputPath, const QString& outputRoot);
+    void cancel();
+
+signals:
+    void started();
+    void caseStatusUpdated(const QString& key, const QString& status);
+    void caseLogUpdated(const QString& key, const QString& log);
+    // The case reached Done, Failed* or Cancelled; emitted once per run.
+    void finished();
+
+private:
+    void onCaseStatusUpdated(const QString& status, const QString& analysisType);
+    // Absolute paths of the files the case's solver writes as its result, existing or not
+    QStringList resultCandidates() const;
+
+    DashJobRunner* m_jobRunner = nullptr;
+    QList<Case> m_cases;
+    QString m_outputRoot;
+    // Where the solver writes: the run folder, or <prt dir>/<prt base> under it for a .wbpj
+    QString m_resultDir;
+    // The result candidates present before the launch, with their modification times
+    QHash<QString, QDateTime> m_resultsBeforeRun;
+    // One serial per launched run(). DashJobRunner reports carry only a key, so every report is
+    // the open case's; with no case open (after Done, Failed* or Cancelled, before the next run)
+    // they belong to an ended run and are dropped.
+    int m_runSerial = 0;
+    // The serial of the run whose case is open; 0 when none
+    int m_activeRunSerial = 0;
+    // The run DashJobRunner::jobStarted last fired for; runDirectJobs emits it only when a task
+    // was submitted
+    int m_submittedRunSerial = 0;
+};
diff --git a/controller/DashDirectLaunchStaging.h b/controller/DashDirectLaunchStaging.h
new file mode 100644
index 00000000..410b73a0
--- /dev/null
+++ b/controller/DashDirectLaunchStaging.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <QDir>
+#include <QFileInfo>
+#include <QString>
+
+// Where a Direct Launch run is staged (#604): the input is copied into
+// <outputRoot>/<input completeBaseName>/ and launched from there. Pure functions, Qt Core only.
+namespace DashDirectLaunchStaging {
+
+inline QString runDirOf(const QString& inputPath, const QString& outputRoot)
+{
+    return QDir(outputRoot).filePath(QFileInfo(inputPath).completeBaseName());
+}
+
+// True when the input already lives inside its run folder, where staging would copy it over
+// itself and a Re-run would delete it. Compared on canonical paths; the run folder may not exist
+// yet, so its path is built on the canonical output root rather than canonicalized itself.
+inline bool inputInsideRunDir(const QString& inputPath, const QString& outputRoot)
+{
+    const QString canonicalRoot = QFileInfo(outputRoot).canonicalFilePath();
+    const QString runDirPrefix = runDirOf(inputPath, canonicalRoot) + QLatin1Char('/');
+    return QFileInfo(inputPath).canonicalFilePath().startsWith(runDirPrefix, Qt::CaseInsensitive);
+}
+
+}  // namespace DashDirectLaunchStaging
