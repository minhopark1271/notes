+/**
+ * @class DashDirectLaunchDialog
+ * @brief Tools > Direct Launch: runs one input file as is and previews its result (#604).
+ *
+ * Modeless and kept alive by DashMainWindow; closing only hides it. The run belongs to the
+ * app-lifetime DashDirectLaunchRunner, so the dialog subscribes to it and re-reads its state
+ * whenever it is shown again.
+ */
+class DashDirectLaunchDialog : public QDialog
+{
+    Q_OBJECT
+
+public:
+    explicit DashDirectLaunchDialog(QWidget* parent = nullptr);
+    ~DashDirectLaunchDialog() override;
+
+    // The Result Preview page's reader, a Set-less DashAnalysisLauncher of its own. DashMainWindow
+    // connects its geometry and field signals to the central view.
+    DashAnalysisLauncher* resultModel() const
+    {
+        return m_resultModel;
+    }
+    // The scalar name of the last Preview, makeSafe(step) + "_" + makeSafe(name)
+    QString previewDisplayName() const
+    {
+        return m_previewDisplayName;
+    }
+    // A project was opened or closed: the picked files and result choices belonged to the old
