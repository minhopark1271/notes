+Result<void> DashGeometryParameterWidget::updateHandleRadius(double radius)
+{
+    if (handleState_ && interaction_ && geometry_) {
+        DASH_RETURN_IF_ERROR(syncHandleSetup());
+    }
+    // Prepare both replacements before committing either. Preserve selected points
+    // and controls without resampling, including the last preview snapshot.
+    decltype(handleState_) replacement;
+    auto preview = previewConfiguration_;
+    if (handleSetup()) {
+        DASH_REF_OR_RETURN(setup,
+                           DashHandleSetup::loads(handleSetup()->dumps(samplingPolicy_), radius));
+        replacement.emplace(std::move(setup));
+    } else if (handleConfiguration()) {
+        DASH_REF_OR_RETURN(configuration,
+                           DashHandleConfiguration::loads(handleConfiguration()->dumps(), radius));
+        replacement.emplace(std::move(configuration));
+    }
+    if (preview) {
+        DASH_REF_OR_RETURN(configuration, DashHandleConfiguration::loads(preview->dumps(), radius));
+        preview = std::move(configuration);
+    }
+    handleState_ = std::move(replacement);
+    previewConfiguration_ = std::move(preview);
+    m_lastValidRadius = radius;
+    // Radius participates in the editor fingerprint: rebaseline it to avoid
+    // dropping confirmed samples on the next preview or Save DV.
+    editorFingerprint_ = 0;
+    if (handleState_ && interaction_ && geometry_) {
+        DASH_RETURN_IF_ERROR(syncHandleSetup());
+    }
+    if (handleConfiguration()) {
+        showHandleConfiguration();
+    }
+    return {};
+}
+Result<void> DashGeometryParameterWidget::syncHandleSetup()
+{
+    if (!interaction_ || !geometry_) {
+        return make_unexpected(ErrorCode::InvalidArgument, "No morphing geometry");
+    }
+    const auto checked = CheckedHandleIds();
+    DASH_REF_OR_RETURN(next,
+                       DashHandleImport::fromPolydata(interaction_->GetMorphingHandles(),
+                                                      interaction_->GetSurfaceGeometry(),
+                                                      MorphingKernelRadius(),
+                                                      checked.empty() ? nullptr : &checked));
+    // Entries with no legacy editor representation remain owned by the new state.
+    const auto preserve = [&](const auto& entries) -> Result<void> {
+        for (const auto& e : entries) {
+            if (!e.isSampled() && (e.isFixed() || (!e.isGroup() && !e.isSection()))) {
+                auto canonical =
+                    DashHandleSets::load(DashHandleSets::dump(e), MorphingKernelRadius());
+                if (!canonical) {
+                    return std::unexpected(canonical.error());
+                }
+                DASH_RETURN_IF_ERROR(next.addPinned(std::move(*canonical)));
+            }
+        }
+        return {};
+    };
+    if (handleSetup()) {
+        DASH_RETURN_IF_ERROR(preserve(handleSetup()->pinned()));
+    } else if (handleConfiguration()) {
+        DASH_RETURN_IF_ERROR(preserve(handleConfiguration()->entries()));
+    }
+    const auto addSurface = [&](const auto& regions) -> Result<void> {
+        for (const auto& r : regions) {
+            if (!DashRegionIsFixed(r)) {
+                DASH_RETURN_IF_ERROR(next.addRegion(r));
+            }
+        }
+        return {};
+    };
+    if (handleSetup()) {
+        DASH_RETURN_IF_ERROR(addSurface(handleSetup()->regions()));
+    } else if (handleConfiguration()) {
+        DASH_RETURN_IF_ERROR(addSurface(handleConfiguration()->regions()));
+    }
+    const auto fixedSurface =
+        DashHandleCloud::fixedSurfaceIds(interaction_->GetSurfaceGeometry(),
+                                         interaction_->nonDesignSurfaceIds(),
+                                         interaction_->constraintSurfaceIds());
+    const auto fixedVolume =
+        DashHandleCloud::fixedVolumeIds(interaction_->GetSurfaceGeometry(), fixedSurface);
+    if ((editorFingerprint_ == 0 || fixedSurface == editorFixedSurfaceIds_)
+        && (handleSetup() || handleConfiguration())) {
+        const auto& regions =
+            handleSetup() ? handleSetup()->regions() : handleConfiguration()->regions();
+        for (const auto& r : regions) {
+            if (DashRegionIsFixed(r)) {
+                DASH_RETURN_IF_ERROR(next.addRegion(r));
+            }
+        }
+    } else if (!fixedVolume.empty()) {
+        DASH_RETURN_IF_ERROR(
+            next.addRegion(DashFixedRegion(DashVolumeIds{ "constraints", fixedVolume })));
+    }
+    editorFixedSurfaceIds_ = fixedSurface;
+    const auto fingerprint = next.fingerprint();
+    if (editorFingerprint_ == 0 && (handleConfiguration() || handleSetup())) {
+        editorFingerprint_ = fingerprint;
+        return {};
+    }
+    if (editorFingerprint_ == fingerprint && (handleConfiguration() || handleSetup())) {
+        return {};
+    }
+    if (handleConfiguration()) {
+        previewConfiguration_ = *handleConfiguration();
+    }
+    clearHandleConfiguration();
+    handleState_ = std::move(next);
+    refreshSampledHandleTree();
+    m_dvGeometryTableView->setToolTip(tr("Unconfirmed handles. Click Done to generate handles."));
+    editorFingerprint_ = fingerprint;
+    if (!samplingPolicyInitialized_) {
+        samplingPolicy_.tolerance = std::max(geometry_->modelBoundSize() * 1e-3, 1e-12);
+        samplingPolicy_.solverThreads = DashMorphingService::interactive().solverThreads();
+        samplingPolicyInitialized_ = true;
+    }
+    return {};
+}
+Result<void> DashGeometryParameterWidget::persistHandleSetup()
+{
+    if (!handleSetup() || !m_currentModel) {
+        return {};
+    }
+    const auto path = m_currentModel->getGeometryParameterJsonPath();
+    QFile source(path);
+    if (!source.open(QIODevice::ReadOnly)) {
+        return make_unexpected(ErrorCode::NotFound, "Cannot read Set for setup persistence");
+    }
+    auto document = QJsonDocument::fromJson(source.readAll());
+    source.close();
+    if (!document.isObject()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "Invalid Set JSON");
+    }
+    auto root = document.object();
+    auto morphing = root["Morphing"].toObject();
+    morphing["handles"] = handleSetup()->dumps(samplingPolicy_);
+    morphing["radius"] = handleSetup()->radius();
+    morphing.remove("handles_vtp");
+    morphing.remove("constraints");
+    root["Morphing"] = morphing;
+    root["DV-Geometry"] = QJsonObject{};
+    QSaveFile target(path);
+    const auto bytes = QJsonDocument(root).toJson();
+    if (!target.open(QIODevice::WriteOnly) || target.write(bytes) != bytes.size()
+        || !target.commit()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "Cannot save handle setup");
+    }
+    return {};
+}
+void DashGeometryParameterWidget::markSurfaceRegion(int maximumHandles)
+{
+    const auto fail = [this](const dash::core::ErrorState& e) {
+        DashNotify::warning(DashLog::Module::Morphing,
+                            this,
+                            "Automatic",
+                            QString::fromStdString(DashMorphingError::describe(e)));
+    };
+    auto ready = syncHandleSetup();
+    if (!ready) {
+        fail(ready.error());
+        return;
+    }
+    auto* surface = interaction_->GetSurfaceGeometry();
+    auto* selection = surface->GetPointData()->GetArray(HandleArrayNames::constraintsAndHandles);
+    auto* ids = surface->GetPointData()->GetArray(HandleArrayNames::volumePointIds);
+    if (!selection || !ids) {
+        DashNotify::warning(DashLog::Module::Morphing,
+                            this,
+                            "Automatic",
+                            "The surface has no selection or volume-point mapping.");
+        return;
+    }
+    DashVolumeIds region{ "surface", {} };
+    for (vtkIdType i = 0; i < surface->GetNumberOfPoints(); ++i) {
+        if (selection->GetTuple1(i) == 3) {
+            region.ids.push_back(vtkIdType(ids->GetTuple1(i)));
+        }
+    }
+    if (region.ids.empty()) {
+        DashNotify::warning(DashLog::Module::Morphing,
+                            this,
+                            "Automatic",
+                            "Paint a surface region before marking it for sampling.");
+        return;
+    }
+    if (handleConfiguration()) {
+        previewConfiguration_ = *handleConfiguration();
+        auto dropped = std::move(*handleConfiguration()).dropSamples();
+        if (!dropped) {
+            fail(dropped.error());
+            return;
+        }
+        handleState_ = std::move(*dropped);
+        clearHandleConfiguration();
+    }
+    for (int i = int(handleSetup()->regions().size()) - 1; i >= 0; --i) {
+        if (!DashRegionIsFixed(handleSetup()->regions()[i])) {
+            handleSetup()->removeRegion(i);
+        }
+    }
+    auto marked = handleSetup()->addRegion(DashControlRegion{ "surface", std::move(region) });
+    if (!marked) {
+        fail(marked.error());
+        return;
+    }
+    samplingPolicy_.maximumHandles = maximumHandles > 0 ? std::size_t(maximumHandles) : 0;
+    samplingPolicy_.tolerance = std::max(geometry_->modelBoundSize() * 1e-3, 1e-12);
+    samplingPolicy_.solverThreads = DashMorphingService::interactive().solverThreads();
+    samplingPolicyInitialized_ = true;
+    editorFingerprint_ = 0;
+    auto synced = syncHandleSetup();
+    if (!synced) {
+        fail(synced.error());
+        return;
+    }
+    auto saved = persistHandleSetup();
+    if (!saved) {
+        fail(saved.error());
+        return;
+    }
+    refreshSampledHandleTree();
+    m_dvGeometryTableView->setToolTip(tr("Surface region marked. Click Done to generate handles."));
+    DASH_LOG_INFO(Morphing) << "Surface region marked; click Done to generate handles";
+}
+QCoro::Task<> DashGeometryParameterWidget::finishHandleEditing()
+{
+    if (samplingInProgress_) {
+        co_return;
+    }
+    const QPointer<DashGeometryParameterWidget> self(this);
+    auto result = co_await sampleHandles();
+    if (!self) {
+        co_return;
+    }
+    if (!result) {
+        if (result.error().code() != ErrorCode::Canceled) {
+            DashNotify::warning(
+                DashLog::Module::Morphing,
+                this,
+                tr("Sampling"),
+                QString::fromStdString(DashMorphingError::describe(result.error())));
+        }
+        co_return;
+    }
+    DashManager::Mgr()->Redraw();
+}
+QCoro::Task<Result<void>> DashGeometryParameterWidget::sampleHandles()
+{
+    auto synced = syncHandleSetup();
+    if (!synced) {
+        co_return std::unexpected(synced.error());
+    }
+    if (handleConfiguration()) {
+        co_return Result<void>{};
+    }
+    if (!handleSetup() || samplingInProgress_) {
+        co_return make_unexpected(ErrorCode::LogicError, "No setup or sampling already running");
+    }
+    auto copy = handleSetup()->duplicate();
+    if (!copy) {
+        co_return std::unexpected(copy.error());
+    }
+    const QPointer<DashGeometryParameterWidget> self(this);
+    const auto geometry = geometry_;
+    const auto key = handleSetup()->fingerprint();
+    auto policy = samplingPolicy_;
+    policy.solverThreads = DashMorphingService::interactive().solverThreads();
+    samplingInProgress_ = true;
+    QElapsedTimer timer;
+    timer.start();
+    auto future = DashMorphingService::interactive().submitSampling(
+        [setup = std::move(*copy), policy, geometry]() mutable {
+            return std::move(setup).sample(policy, *geometry);
+        });
+    auto result = co_await awaitResult(std::move(future));
+    if (!self) {
+        co_return make_unexpected(ErrorCode::Canceled, "sampling owner closed");
+    }
+    samplingInProgress_ = false;
+    if (geometry_ != geometry) {
+        co_return make_unexpected(ErrorCode::Canceled, "sampling target changed");
+    }
+    synced = syncHandleSetup();
+    if (!synced) {
+        co_return std::unexpected(synced.error());
+    }
+    if (!handleSetup() || handleSetup()->fingerprint() != key
+        || samplingPolicy_.maximumHandles != policy.maximumHandles
+        || samplingPolicy_.tolerance != policy.tolerance) {
+        co_return make_unexpected(ErrorCode::Canceled,
+                                  "setup changed during sampling; click Done again");
+    }
+    if (!result) {
+        co_return std::unexpected(result.error());
+    }
+    handleState_ = std::move(*result);
+    clearHandleSetup();
+    previewConfiguration_ = *handleConfiguration();
+    const auto& summary = handleConfiguration()->summary();
+    DASH_LOG_INFO(Morphing) << "Sampling:" << summary.sampledCount << "selected, moving residual"
+                            << summary.maximumMovingResidual << "fixed residual"
+                            << summary.maximumFixedResidual << "outcome" << int(summary.outcome)
+                            << "elapsed ms" << timer.elapsed();
+    showHandleConfiguration();
+    if (GetPreviewType() != PreviewType::None) {
+        runPreviewMorph(PreviewTrigger::Arm);
+    }
+    co_return Result<void>{};
+}
+void DashGeometryParameterWidget::refreshSampledHandleTree()
+{
+    if (interaction_) {
+        std::vector<vtkIdType> controlIds;
+        if (handleConfiguration() || handleSetup()) {
+            const auto& regions =
+                handleConfiguration() ? handleConfiguration()->regions() : handleSetup()->regions();
+            for (const auto& region : regions) {
+                if (!DashRegionIsFixed(region)) {
+                    const auto& ids = std::get<DashControlRegion>(region).volumeIds.ids;
+                    controlIds.insert(controlIds.end(), ids.begin(), ids.end());
+                }
+            }
+        }
+        interaction_->SetControlRegionOverlay(controlIds, handleConfiguration() != nullptr);
+    }
+    if (handleConfiguration()) {
+        DashSampledHandleTree::update(
+            m_handleTree,
+            handleConfiguration()->entries(),
+            false,
+            [this](const QString& name,
+                   const QString& control,
+                   bool enabled,
+                   double lower,
+                   double upper) {
+                if (!handleConfiguration()) {
+                    return false;
+                }
+                const auto& entries = handleConfiguration()->entries();
+                auto it = std::find_if(
+                    entries.begin(), entries.end(), [&](const auto& e) { return e.name == name; });
+                if (it == entries.end()) {
+                    return false;
+                }
+                const int index = int(it - entries.begin());
+                auto changed =
+                    handleConfiguration()->withControlBounds(index, control, lower, upper);
+                if (!changed) {
+                    DashNotify::warning(
+                        DashLog::Module::Morphing,
+                        this,
+                        tr("Design Variable"),
+                        QString::fromStdString(DashMorphingError::describe(changed.error())));
+                    return false;
+                }
+                changed = changed->withControlEnabled(index, control, enabled);
+                if (!changed) {
+                    return false;
+                }
+                handleState_ = std::move(*changed);
+                previewConfiguration_ = *handleConfiguration();
+                // Rebuild only after the editor/header checkbox signal has returned.
+                QTimer::singleShot(0, this, [this] {
+                    showHandleConfiguration();
+                    updateHandleTreeHeaderCheckBoxState();
+                    UpdatePreviewMorphing();
+                });
+                return true;
+            });
+    } else if (previewConfiguration_) {
+        DashSampledHandleTree::update(m_handleTree, previewConfiguration_->entries(), true);
+    } else {
+        DashSampledHandleTree::update(m_handleTree, {});
+    }
+}
+void DashGeometryParameterWidget::showHandleConfiguration()
+{
+    if (!handleConfiguration()) {
+        return;
+    }
+    refreshSampledHandleTree();
+    if (visualizer_) {
+        visualizer_->UpdateSampledHandles(handleConfiguration()->entries());
+    }
+    if (!configurationTable_) {
+        configurationTable_ = new QStandardItemModel(this);
+        connect(configurationTable_,
+                &QStandardItemModel::itemChanged,
+                this,
+                [this](QStandardItem* item) {
+                    if (!handleConfiguration() || item->column() < 2 || item->column() > 3) {
+                        return;
+                    }
+                    const int row = item->row();
+                    const int set = configurationTable_->item(row, 0)->data(Qt::UserRole).toInt();
+                    const auto control = configurationTable_->item(row, 1)->text();
+                    bool loOk = false, hiOk = false;
+                    const auto lo = configurationTable_->item(row, 2)->text().toDouble(&loOk);
+                    const auto hi = configurationTable_->item(row, 3)->text().toDouble(&hiOk);
+                    if (!loOk || !hiOk) {
+                        showHandleConfiguration();
+                        return;
+                    }
+                    auto edited = handleConfiguration()->withControlBounds(set, control, lo, hi);
+                    if (!edited) {
+                        DashNotify::warning(
+                            DashLog::Module::Morphing,
+                            this,
+                            "Design Variable",
+                            QString::fromStdString(DashMorphingError::describe(edited.error())));
+                        showHandleConfiguration();
+                        return;
+                    }
+                    handleState_ = std::move(*edited);
+                    previewConfiguration_ = *handleConfiguration();
+                    interaction_->GetMorphingHandles()->DeepCopy(
+                        DashHandleImport::editingProjection(handleConfiguration()->entries()));
+                    interaction_->SyncHandleGizmosFromGeometry();
+                    updateHandleTreeFromInteraction(false);
+                    editorFingerprint_ = 0;
+                    auto synced = syncHandleSetup();
+                    if (!synced) {
+                        return;
+                    }
+                    UpdatePreviewMorphing();
+                });
+        m_dvGeometryTableView->setContextMenuPolicy(Qt::CustomContextMenu);
+        connect(m_dvGeometryTableView,
+                &QWidget::customContextMenuRequested,
+                this,
+                &DashGeometryParameterWidget::editConfigurationGroups);
+    }
+    const QSignalBlocker blocker(configurationTable_);
+    configurationTable_->clear();
+    configurationTable_->setHorizontalHeaderLabels(
+        { "Set", "Control", "Lower", "Upper", "Origin" });
+    const auto& entries = handleConfiguration()->entries();
+    for (int set = 0; set < int(entries.size()); ++set) {
+        const auto& e = entries[set];
+        if (e.isFixed()) {
+            continue;
+        }
+        for (const auto& c : e.controls) {
+            if (!c.enabled) {
+                continue;
+            }
+            QList<QStandardItem*> row{ new QStandardItem(e.name),
+                                       new QStandardItem(c.name),
+                                       new QStandardItem(QString::number(c.lower, 'g', 17)),
+                                       new QStandardItem(QString::number(c.upper, 'g', 17)),
+                                       new QStandardItem(!e.isSampled() ? "Pinned" : "Sampled") };
+            row[0]->setData(set, Qt::UserRole);
+            for (int i : { 0, 1, 4 }) {
+                row[i]->setEditable(false);
+            }
+            configurationTable_->appendRow(row);
+        }
+    }
+    m_dvGeometryTableView->setModel(configurationTable_);
+    m_dvGeometryTableView->setSelectionBehavior(QAbstractItemView::SelectRows);
+    m_dvGeometryTableView->setSelectionMode(QAbstractItemView::ExtendedSelection);
+    m_dvGeometryTableView->horizontalHeader()->setSectionResizeMode(QHeaderView::Stretch);
+    const auto& summary = handleConfiguration()->summary();
+    m_dvGeometryTableView->setToolTip(
+        tr("Sampled %1 handles; residuals moving %2, fixed %3; outcome %4")
+            .arg(summary.sampledCount)
+            .arg(summary.maximumMovingResidual)
+            .arg(summary.maximumFixedResidual)
+            .arg(int(summary.outcome)));
+}
+void DashGeometryParameterWidget::editConfigurationGroups(const QPoint& position)
+{
+    if (!handleConfiguration() || !configurationTable_) {
+        return;
+    }
+    std::set<int> selected;
+    for (const auto& row : m_dvGeometryTableView->selectionModel()->selectedRows()) {
+        selected.insert(configurationTable_->item(row.row(), 0)->data(Qt::UserRole).toInt());
+    }
+    if (selected.empty()) {
+        return;
+    }
+    QMenu menu(this);
+    auto* group = menu.addAction(tr("Group"));
+    auto* ungroup = menu.addAction(tr("Ungroup"));
+    auto* pin = menu.addAction(tr("Pin"));
+    bool canGroup = selected.size() > 1;
+    const auto& first = handleConfiguration()->entries()[*selected.begin()];
+    for (int i : selected) {
+        const auto& e = handleConfiguration()->entries()[i];
+        canGroup = canGroup && e.isGroup() && e.controls.size() == 1 && first.controls.size() == 1
+                   && e.sampledFrom == first.sampledFrom
+                   && e.controls[0].id() == first.controls[0].id()
+                   && e.controls[0].direction == first.controls[0].direction
+                   && e.controls[0].enabled == first.controls[0].enabled;
+    }
+    group->setEnabled(canGroup);
+    ungroup->setEnabled(selected.size() == 1
+                        && handleConfiguration()->entries()[*selected.begin()].isGroup());
+    pin->setEnabled(selected.size() == 1 && first.isSampled());
+    auto* chosen = menu.exec(m_dvGeometryTableView->viewport()->mapToGlobal(position));
+    if (!chosen) {
+        return;
+    }
+    std::vector<int> ids(selected.begin(), selected.end());
+    auto changed = chosen == group     ? handleConfiguration()->group(ids)
+                   : chosen == ungroup ? handleConfiguration()->ungroup(ids[0])
+                                       : handleConfiguration()->pin(ids[0]);
+    if (!changed) {
+        DashNotify::warning(DashLog::Module::Morphing,
+                            this,
+                            "Design Variables",
+                            QString::fromStdString(DashMorphingError::describe(changed.error())));
+        return;
+    }
+    handleState_ = std::move(*changed);
+    previewConfiguration_ = *handleConfiguration();
+    interaction_->GetMorphingHandles()->DeepCopy(
+        DashHandleImport::editingProjection(handleConfiguration()->entries()));
+    interaction_->SyncHandleGizmosFromGeometry();
+    updateHandleTreeFromInteraction(false);
+    editorFingerprint_ = 0;
+    auto synced = syncHandleSetup();
+    if (!synced) {
+        return;
+    }
+    showHandleConfiguration();
+    UpdatePreviewMorphing();
+}
