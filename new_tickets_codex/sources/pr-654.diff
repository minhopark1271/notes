-    }
-
-    vtkSmartPointer<vtkPolyData> markers =
-        NonDesignUtils::GenerateMarkerPointsFromSurfaceIds(*in.fixedSurfaceIds,
-                                                           in.surface,
-                                                           in.designHandlePoints,
-                                                           in.supportRadius,
-                                                           NonDesignUtils::MARKER_POISSON_SPACING);
-
-    auto* originalIds =
-        markers ? vtkIntArray::SafeDownCast(markers->GetPointData()->GetArray("OriginalIds"))
-                : nullptr;
-
-    if (originalIds) {
-        result.surfaceIds.reserve(originalIds->GetNumberOfTuples());
-        for (vtkIdType i = 0; i < originalIds->GetNumberOfTuples(); ++i) {
-            result.surfaceIds.push_back(originalIds->GetValue(i));
-        }
-    }
-
-    // 선별이 0개를 냈어도 지문은 기록한다. 그래야 같은 입력으로 다시 부를 때
-    // 비싼 선별을 되풀이하지 않는다.
