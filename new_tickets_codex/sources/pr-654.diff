+++ b/controller/DashHandleState.cpp
@@ -0,0 +1,532 @@
+#include "controller/DashHandleState.h"
+#include <MeshOps/MeshOps/Morphing/BoxHandles.hpp>
+#include <MeshOps/MeshOps/Morphing/GroupHandles.hpp>
+#include <MeshOps/MeshOps/Morphing/HandleConfiguration.hpp>
+#include <MeshOps/MeshOps/Morphing/SectionFrameHandles.hpp>
+#include <QCryptographicHash>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include "utils/log/DashLog.h"
+using dash::core::ErrorCode;
+using dash::core::make_unexpected;
+using dash::core::Result;
+namespace {
+using Entry = DashHandleEntry;
+void append(DashHandleBlock& to, const DashHandleBlock& from)
+{
+    to.positions.insert(to.positions.end(), from.positions.begin(), from.positions.end());
+    to.supportRadii.insert(
+        to.supportRadii.end(), from.supportRadii.begin(), from.supportRadii.end());
+    if (from.ownerIds.empty()) {
+        to.ownerIds.insert(to.ownerIds.end(), from.size(), -1);
+    } else {
+        to.ownerIds.insert(to.ownerIds.end(), from.ownerIds.begin(), from.ownerIds.end());
+    }
+}
+Result<DashLiveSet> clone(const Entry& entry)
+{
+    return std::visit(
+        [](const auto& original) -> Result<DashLiveSet> {
+            if (!original) {
+                return make_unexpected(ErrorCode::InvalidArgument, "handle entry has no set");
+            }
+            using T = std::remove_const_t<typename std::decay_t<decltype(original)>::element_type>;
+            DASH_REF_OR_RETURN(copy, T::load(original->dump()));
+            return DashLiveSet{ std::move(copy) };
+        },
+        entry.set);
+}
+DashFrozenSet freeze(const DashLiveSet& live)
+{
+    return std::visit([](const auto& p) -> DashFrozenSet { return p; }, live);
+}
+const dash::mesh::IHandleSet& base(const DashFrozenSet& set)
+{
+    return std::visit([](const auto& p) -> const dash::mesh::IHandleSet& { return *p; }, set);
+}
+}  // namespace
+Result<DashHandleBlock> DashHandleSets::block(const Entry& entry)
+{
+    if (!std::visit([](const auto& p) { return bool(p); }, entry.set)) {
+        return make_unexpected(ErrorCode::InvalidArgument, "handle entry has no set");
+    }
+    DASH_REF_OR_RETURN(value, dash::mesh::HandleConfiguration::capture(base(entry.set)));
+    DashHandleBlock out;
+    out.role = !entry.isFixed() ? "design" : "marker";
+    for (const auto& p : value.positions()) {
+        out.positions.push_back({ p.x, p.y, p.z });
+    }
+    out.supportRadii.assign(value.support_radii().begin(), value.support_radii().end());
+    out.ownerIds = entry.ownerIds;
+    DASH_RETURN_IF_ERROR(out.validate());
+    return out;
+}
+Result<Entry> DashHandleSets::group(const DashHandleBlock& block,
+                                    std::span<const std::array<double, 3>> field)
+{
+    DASH_RETURN_IF_ERROR(block.validate());
+    if (block.empty() || (!field.empty() && field.size() != block.size())) {
+        return make_unexpected(ErrorCode::InvalidArgument,
+                               "group: empty points or wrong field length");
+    }
+    dash::mesh::GroupHandlesOptions options;
+    for (const auto& p : block.positions) {
+        options.positions.push_back({ p[0], p[1], p[2] });
+    }
+    options.support_radii = block.supportRadii;
+    for (const auto& v : field) {
+        options.field.push_back({ v[0], v[1], v[2] });
+    }
+    auto result = dash::mesh::GroupHandles::create(std::move(options));
+    if (!result) {
+        return std::unexpected(result.error());
+    }
+    Entry out;
+    out.set = std::move(*result);
+    out.ownerIds = block.ownerIds;
+    if (block.role != "marker") {
+        out.controls.push_back(
+            { field.empty() ? QStringLiteral("translation") : QStringLiteral("rate") });
+    }
+    return out;
+}
+Result<Entry> DashHandleSets::section(const std::array<double, 16>& m,
+                                      const std::array<double, 6>& b,
+                                      double radius)
+{
+    if (!std::isfinite(radius) || radius <= 0) {
+        return make_unexpected(ErrorCode::InvalidArgument, "section: invalid radius");
+    }
+    dash::mesh::SectionFrame f;
+    f.origin = { m[3] + b[4] * m[2], m[7] + b[4] * m[6], m[11] + b[4] * m[10] };
+    f.x_axis = { m[0], m[4], m[8] };
+    f.y_axis = { m[1], m[5], m[9] };
+    f.z_axis = { m[2], m[6], m[10] };
+    f.x_min = b[0];
+    f.x_max = b[1];
+    f.y_min = b[2];
+    f.y_max = b[3];
+    DASH_REF_OR_RETURN(set,
+                       dash::mesh::SectionFrameHandles::create(
+                           { .frame = f, .num_subdivisions = 4, .support_radius = radius }));
+    Entry out;
+    out.set = std::move(set);
+    for (int i = 0; i < 4; ++i) {
+        out.controls.push_back({ QStringLiteral("edge:%1").arg(i) });
+    }
+    return out;
+}
+Result<void> DashHandleControl::apply(DashLiveSet& copy, double value) const
+{
+    if (!std::isfinite(value)) {
+        return make_unexpected(ErrorCode::InvalidArgument, "non-finite DV value");
+    }
+    return std::visit(
+        [&](auto& set) -> Result<void> {
+            using T = typename std::decay_t<decltype(set)>::element_type;
+            if (!set) {
+                return make_unexpected(ErrorCode::InvalidArgument, "missing set");
+            }
+            if constexpr (std::is_same_v<T, dash::mesh::GroupHandles>) {
+                if (name == "rate" && set->control() == dash::mesh::GroupControl::FieldRate) {
+                    return set->set_rate(value);
+                }
+                if (name == "translation"
+                    && set->control() == dash::mesh::GroupControl::Translation) {
+                    for (double d : direction) {
+                        if (!std::isfinite(d)) {
+                            return make_unexpected(ErrorCode::InvalidArgument,
+                                                   "non-finite direction");
+                        }
+                    }
+                    return set->set_translation(
+                        { value * direction[0], value * direction[1], value * direction[2] });
+                }
+            } else {
+                const bool section = std::is_same_v<T, dash::mesh::SectionFrameHandles>;
+                const QString prefix = section ? "edge:" : "face:";
+                bool ok = false;
+                const int index = name.mid(prefix.size()).toInt(&ok);
+                if (!name.startsWith(prefix) || !ok || index < 0 || index >= (section ? 4 : 6)) {
+                    return make_unexpected(ErrorCode::InvalidArgument, "invalid face/edge control");
+                }
+                if constexpr (std::is_same_v<T, dash::mesh::SectionFrameHandles>) {
+                    auto pose = set->edges();
+                    double* components[]{ &pose.x_min, &pose.x_max, &pose.y_min, &pose.y_max };
+                    *components[index] = value;
+                    return set->set_edges(pose);
+                } else {
+                    auto pose = set->faces();
+                    double* components[]{ &pose.x_min, &pose.x_max, &pose.y_min,
+                                          &pose.y_max, &pose.z_min, &pose.z_max };
+                    *components[index] = value;
+                    return set->set_faces(pose);
+                }
+            }
+            return make_unexpected(ErrorCode::InvalidArgument, "control does not match set");
+        },
+        copy);
+}
+Result<DashHandleMotion> DashHandleSets::motion(const Entry& entry, const DashDvValues& values)
+{
+    DASH_REF_OR_RETURN(after, clone(entry));
+    if (std::any_of(
+            values.begin(), values.end(), [](const auto& v) { return !std::isfinite(v.value); })) {
+        return make_unexpected(ErrorCode::InvalidArgument, "non-finite DV value");
+    }
+    auto ordered = values;
+    // Face/edge values are outward offsets. Expand before contracting so a valid
+    // combined pose is not rejected because of an invalid intermediate rectangle.
+    std::stable_sort(ordered.begin(), ordered.end(), [](const auto& a, const auto& b) {
+        return a.value > b.value;
+    });
+    for (const auto& v : ordered) {
+        const auto control = std::find_if(entry.controls.begin(),
+                                          entry.controls.end(),
+                                          [&](const auto& c) { return c.id() == v.control; });
+        if (control == entry.controls.end()) {
+            return make_unexpected(ErrorCode::InvalidArgument, "unknown handle control");
+        }
+        DASH_RETURN_IF_ERROR(control->apply(after, v.value));
+    }
+    DASH_REF_OR_RETURN(
+        captured, dash::mesh::HandleConfiguration::capture(base(freeze(after)), base(entry.set)));
+    DashHandleMotion out;
+    for (const auto& d : captured.displacements()) {
+        out.displacements.push_back({ d.x, d.y, d.z });
+    }
+    if (out.empty()) {
+        out.appendZeros(captured.size());
+    }
+    return out;
+}
+Result<int> DashHandleSetup::addPinned(Entry entry)
+{
+    if (entry.name.isEmpty()) {
+        entry.name = QStringLiteral("set-%1").arg(pinned_.size());
+    }
+    if (std::any_of(
+            pinned_.begin(), pinned_.end(), [&](const auto& e) { return e.name == entry.name; })) {
+        return make_unexpected(ErrorCode::InvalidArgument, "duplicate handle entry name");
+    }
+    DashDvValues zero;
+    std::set<QString> controls;
+    for (const auto& c : entry.controls) {
+        if (!controls.insert(c.name).second || !std::isfinite(c.lower) || !std::isfinite(c.upper)
+            || c.lower > c.upper) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "invalid control bounds or duplicate control");
+        }
+        zero.push_back({ entry.name, c.name, 0 });
+    }
+    DASH_RETURN_IF_ERROR(DashHandleSets::motion(entry, zero));
+    DASH_REF_OR_RETURN(block, DashHandleSets::block(entry));
+    if (block.empty()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "empty pinned set");
+    }
+    for (double r : block.supportRadii) {
+        if (r != radius_) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "pinned radius differs from Set radius");
+        }
+    }
+    DASH_REF_OR_RETURN(owned, clone(entry));
+    entry.set = freeze(owned);
+    liveSets_.push_back(std::move(owned));
+    entry.sampledFrom.reset();
+    pinned_.push_back(std::move(entry));
+    return int(pinned_.size() - 1);
+}
+Result<void> DashHandleSetup::addRegion(DashUnpinnedRegion region)
+{
+    const auto name = DashRegionName(region);
+    if (name.isEmpty() || std::any_of(unpinned_.begin(), unpinned_.end(), [&](const auto& r) {
+            return DashRegionName(r) == name;
+        })) {
+        return make_unexpected(ErrorCode::InvalidArgument, "empty or duplicate region name");
+    }
+    unpinned_.push_back(std::move(region));
+    return {};
+}
+void DashHandleSetup::remove(int i)
+{
+    if (i >= 0 && i < int(pinned_.size())) {
+        pinned_.erase(pinned_.begin() + i);
+        liveSets_.erase(liveSets_.begin() + i);
+    }
+}
+void DashHandleSetup::removeRegion(int i)
+{
+    if (i >= 0 && i < int(unpinned_.size())) {
+        unpinned_.erase(unpinned_.begin() + i);
+    }
+}
+std::uint64_t DashHandleSetup::fingerprint() const
+{
+    const auto bytes = QCryptographicHash::hash(
+        QJsonDocument(dumps({})).toJson(QJsonDocument::Compact), QCryptographicHash::Sha256);
+    std::uint64_t key = 0;
+    for (int i = 0; i < 8; ++i) {
+        key = (key << 8) | static_cast<unsigned char>(bytes[i]);
+    }
+    return key;
+}
+Result<DashHandleSetup> DashHandleSetup::duplicate() const
+{
+    DashHandleSetup out(radius_);
+    for (const auto& entry : pinned_) {
+        DASH_REF_OR_RETURN(copy, DashHandleSets::load(DashHandleSets::dump(entry), radius_));
+        DASH_RETURN_IF_ERROR(out.addPinned(std::move(copy)));
+    }
+    out.unpinned_ = unpinned_;
+    return out;
+}
+Result<DashHandleSetup> DashHandleConfiguration::dropSamples() &&
+{
+    DashHandleSetup out(radius_);
+    for (const auto& entry : entries_) {
+        if (!entry.isSampled()) {
+            DASH_REF_OR_RETURN(copy, DashHandleSets::load(DashHandleSets::dump(entry), radius_));
+            DASH_RETURN_IF_ERROR(out.addPinned(std::move(copy)));
+        }
+    }
+    out.unpinned_ = unpinned_;
+    entries_.clear();
+    unpinned_.clear();
+    return out;
+}
+Result<std::vector<DashHandleBlock>> DashHandleConfiguration::controlBlocks() const
+{
+    std::vector<DashHandleBlock> out;
+    for (const auto& e : entries_) {
+        if (!e.isFixed()) {
+            DASH_REF_OR_RETURN(b, DashHandleSets::block(e));
+            out.push_back(std::move(b));
+        }
+    }
+    return out;
+}
+Result<DashHandleBlock> DashHandleConfiguration::designBlock() const
+{
+    DASH_REF_OR_RETURN(blocks, controlBlocks());
+    DashHandleBlock out;
+    out.role = "design";
+    for (const auto& b : blocks) {
+        append(out, b);
+    }
+    return out;
+}
+Result<DashHandleBlock> DashHandleConfiguration::fixedBlock() const
+{
+    DashHandleBlock out;
+    out.role = "marker";
+    for (const auto& e : entries_) {
+        if (e.isFixed()) {
+            DASH_REF_OR_RETURN(b, DashHandleSets::block(e));
+            append(out, b);
+        }
+    }
+    out.ownerIds.clear();
+    return out;
+}
+Result<DashHandleMotion> DashHandleConfiguration::prescription(const DashDvValues& values) const
+{
+    std::set<std::pair<QString, QString>> addresses;
+    for (const auto& v : values) {
+        const auto entry = std::find_if(
+            entries_.begin(), entries_.end(), [&](const auto& e) { return e.name == v.set; });
+        if (entry == entries_.end() || entry->isFixed()
+            || !addresses.emplace(v.set, v.control).second) {
+            return make_unexpected(ErrorCode::InvalidArgument, "invalid or duplicate DV address");
+        }
+        const auto control = std::find_if(entry->controls.begin(),
+                                          entry->controls.end(),
+                                          [&](const auto& c) { return c.id() == v.control; });
+        if (control == entry->controls.end() || !control->enabled) {
+            return make_unexpected(ErrorCode::InvalidArgument, "unknown or disabled DV control");
+        }
+    }
+    DashHandleMotion out;
+    for (int i = 0; i < int(entries_.size()); ++i) {
+        if (!entries_[i].isFixed()) {
+            DashDvValues local;
+            for (const auto& v : values) {
+                if (v.set == entries_[i].name) {
+                    local.push_back(v);
+                }
+            }
+            DASH_REF_OR_RETURN(m, DashHandleSets::motion(entries_[i], local));
+            out.displacements.insert(
+                out.displacements.end(), m.displacements.begin(), m.displacements.end());
+        }
+    }
+    return out;
+}
+DashDvValues DashHandleConfiguration::bounds(bool upper) const
+{
+    DashDvValues out;
+    for (int i = 0; i < int(entries_.size()); ++i) {
+        if (!entries_[i].isFixed()) {
+            for (const auto& c : entries_[i].controls) {
+                if (!c.enabled) {
+                    continue;
+                }
+                out.push_back({ entries_[i].name, c.name, upper ? c.upper : c.lower });
+            }
+        }
+    }
+    return out;
+}
+DashHandleConfiguration DashHandleConfiguration::preview(const DashHandleSetup& setup,
+                                                         const DashHandleConfiguration& old)
+{
+    DashHandleConfiguration out = old;
+    out.entries_ = setup.pinned_;
+    out.radius_ = setup.radius_;
+    for (const auto& e : old.entries_) {
+        if (e.isSampled()) {
+            out.entries_.push_back(e);
+        }
+    }
+    out.setupKey_ = setup.fingerprint();
+    return out;
+}
+Result<DashHandleConfiguration> DashHandleConfiguration::pin(int index) const
+{
+    if (index < 0 || index >= int(entries_.size())) {
+        return make_unexpected(ErrorCode::InvalidArgument, "pin: invalid entry");
+    }
+    auto out = *this;
+    out.entries_[index].sampledFrom.reset();
+    return out;
+}
+Result<DashHandleConfiguration> DashHandleConfiguration::ungroup(int index) const
+{
+    if (index < 0 || index >= int(entries_.size()) || !entries_[index].isGroup()
+        || entries_[index].isFixed()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "ungroup requires a design group");
+    }
+    const auto& e = entries_[index];
+    DASH_REF_OR_RETURN(b, DashHandleSets::block(e));
+    if (e.controls.size() != 1) {
+        return make_unexpected(ErrorCode::InvalidArgument, "ungroup requires one control");
+    }
+    DASH_REF_OR_RETURN(m, DashHandleSets::motion(e, { { e.name, e.controls[0].name, 1.0 } }));
+    auto out = *this;
+    std::vector<Entry> replacements;
+    for (std::size_t i = 0; i < b.size(); ++i) {
+        DashHandleBlock point;
+        point.role = b.role;
+        point.positions = { b.positions[i] };
+        point.supportRadii = { b.supportRadii[i] };
+        if (!b.ownerIds.empty()) {
+            point.ownerIds = { b.ownerIds[i] };
+        }
+        DASH_REF_OR_RETURN(single,
+                           DashHandleSets::group(point, std::span(m.displacements).subspan(i, 1)));
+        single.name = e.name + QStringLiteral("/%1").arg(i);
+        single.sampledFrom = e.sampledFrom;
+        single.controls[0].enabled = e.controls[0].enabled;
+        single.controls[0].lower = e.controls[0].lower;
+        single.controls[0].upper = e.controls[0].upper;
+        replacements.push_back(std::move(single));
+    }
+    out.entries_.erase(out.entries_.begin() + index);
+    out.entries_.insert(out.entries_.begin() + index, replacements.begin(), replacements.end());
+    DASH_LOG_WARN(Morphing) << "Ungroup: independent controls exceed the sampled training fields";
+    return out;
+}
+Result<DashHandleConfiguration> DashHandleConfiguration::group(std::span<const int> indices) const
+{
+    std::set<int> ids(indices.begin(), indices.end());
+    if (ids.size() < 2 || ids.size() != indices.size()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "group requires distinct entries");
+    }
+    DashHandleBlock merged;
+    merged.role = "design";
+    std::vector<std::array<double, 3>> field;
+    std::optional<QString> source;
+    bool first = true;
+    for (int i : ids) {
+        if (i < 0 || i >= int(entries_.size()) || entries_[i].isFixed()
+            || entries_[i].controls.size() != 1) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "group requires single-control design entries");
+        }
+        const auto& e = entries_[i];
+        if (first) {
+            source = e.sampledFrom;
+            first = false;
+        } else if (source != e.sampledFrom) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "cannot group different sampling origins");
+        }
+        if (!e.isGroup() || e.controls[0].name != entries_[*ids.begin()].controls[0].name
+            || e.controls[0].direction != entries_[*ids.begin()].controls[0].direction
+            || e.controls[0].enabled != entries_[*ids.begin()].controls[0].enabled) {
+            return make_unexpected(ErrorCode::InvalidArgument, "incompatible group controls");
+        }
+        DASH_REF_OR_RETURN(b, DashHandleSets::block(e));
+        append(merged, b);
+        DASH_REF_OR_RETURN(m, DashHandleSets::motion(e, { { e.name, e.controls[0].name, 1.0 } }));
+        field.insert(field.end(), m.displacements.begin(), m.displacements.end());
+    }
+    DASH_REF_OR_RETURN(e, DashHandleSets::group(merged, field));
+    e.sampledFrom = source;
+    e.name = entries_[*ids.begin()].name;
+    e.controls[0].enabled = entries_[*ids.begin()].controls[0].enabled;
+    e.controls[0].lower = entries_[*ids.begin()].controls[0].lower;
+    e.controls[0].upper = entries_[*ids.begin()].controls[0].upper;
+    auto out = *this;
+    out.entries_.clear();
+    for (int i = 0; i < int(entries_.size()); ++i) {
+        if (i == *ids.begin()) {
+            out.entries_.push_back(e);
+        }
+        if (!ids.contains(i)) {
+            out.entries_.push_back(entries_[i]);
+        }
+    }
+    return out;
+}
+Result<DashHandleConfiguration> DashHandleConfiguration::withControlBounds(int index,
+                                                                           const QString& name,
+                                                                           double lower,
+                                                                           double upper) const
+{
+    if (index < 0 || index >= int(entries_.size()) || !std::isfinite(lower) || !std::isfinite(upper)
+        || lower > upper) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid control bounds");
+    }
+    auto out = *this;
+    auto& controls = out.entries_[index].controls;
+    auto it = std::find_if(
+        controls.begin(), controls.end(), [&](const auto& c) { return c.name == name; });
+    if (it == controls.end()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "unknown control");
+    }
+    it->lower = lower;
+    it->upper = upper;
+    return out;
+}
+
+Result<DashHandleConfiguration> DashHandleConfiguration::withControlEnabled(int index,
+                                                                            const QString& name,
+                                                                            bool enabled) const
+{
+    if (index < 0 || index >= int(entries_.size())) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid entry");
+    }
+    auto out = *this;
+    auto& controls = out.entries_[index].controls;
+    auto it = std::find_if(
+        controls.begin(), controls.end(), [&](const auto& c) { return c.id() == name; });
+    if (it == controls.end()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "unknown control");
+    }
+    it->enabled = enabled;
+    return out;
+}
