-void DashFixedMarkerSelection::AttachTo(vtkPolyData* handlesVtp,
-                                        vtkPoints* markerPoints,
-                                        const std::vector<vtkIdType>& surfaceIds,
-                                        std::uint64_t key)
-{
-    if (!handlesVtp || !markerPoints) {
