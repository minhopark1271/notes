+dash::core::Result<DashHandleBlock> block(const DashHandleEntry& entry);
+dash::core::Result<DashHandleMotion> motion(const DashHandleEntry& entry,
+                                            const DashDvValues& values);
+DashHandleSamplingPolicy policyFromJson(const QJsonObject& json);
+}  // namespace DashHandleSets
diff --git a/controller/DashHandleStateJson.cpp b/controller/DashHandleStateJson.cpp
