+    void movingAndFixedShareSamplingAndSurviveReload()
+    {
+        if (DashTestLevel::requestedLevel() < DashTestLevel::Level::Push) {
+            QSKIP("Level 2 solver test");
+        }
+        auto surface = MorphingCollectorFixture::surface(false);
+        vtkNew<vtkDoubleArray> normals;
+        normals->SetNumberOfComponents(3);
+        for (int i = 0; i < 4; ++i) {
+            normals->InsertNextTuple3(0, 0, 1);
+        }
+        surface->GetPointData()->SetNormals(normals);
+        vtkNew<vtkUnstructuredGrid> volume;
+        volume->SetPoints(surface->GetPoints());
+        DashHandleSetup setup(5);
+        QVERIFY(
+            setup.addRegion(DashControlRegion{ "moving", DashVolumeIds{ "moving", { 0, 1, 2 } } }));
+        QVERIFY(setup.addRegion(DashFixedRegion(DashVolumeIds{ "fixed", { 3 } })));
+        DashHandleSamplingPolicy policy;
+        policy.solverThreads = 1;
+        auto config = std::move(setup).sample(policy, surface, volume);
+        QVERIFY(config);
+        QVERIFY(!config->designBlock()->empty());
+        QVERIFY(!config->fixedBlock()->empty());
+        const auto markers = *config->fixedBlock();
+        auto loaded = DashHandleConfiguration::loads(config->dumps(), 5);
+        QVERIFY(loaded);
+        QCOMPARE(loaded->fixedBlock()->positions, markers.positions);
+        auto edit = std::move(*loaded).dropSamples();
+        QCOMPARE(edit->regions().size(), std::size_t(2));
+        auto again = std::move(*edit).sample(policy, surface, volume);
+        QVERIFY(again);
+        QCOMPARE(again->fixedBlock()->positions, markers.positions);
+        QCOMPARE(again->designBlock()->positions, config->designBlock()->positions);
+    }
