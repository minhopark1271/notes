diff --git a/controller/DashHandleArchive.cpp b/controller/DashHandleArchive.cpp
new file mode 100644
index 00000000..0e678fd4
--- /dev/null
+++ b/controller/DashHandleArchive.cpp
@@ -0,0 +1,51 @@
+#include "controller/DashHandleArchive.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <vtkNew.h>
+#include <vtkPolyData.h>
+using dash::core::ErrorCode;
+using dash::core::make_unexpected;
+using dash::core::Result;
+Result<DashHandleArchive::Loaded> DashHandleArchive::load(const QString& path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return make_unexpected(ErrorCode::NotFound,
+                               "cannot read handle settings: " + path.toStdString());
+    }
+    const auto doc = QJsonDocument::fromJson(file.readAll());
+    if (!doc.isObject()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid handle settings JSON");
+    }
+    const auto root = doc.object(), morphing = root["Morphing"].toObject();
+    const auto radius = morphing["radius"].toDouble();
+    if (morphing.contains("handles")) {
+        DASH_REF_OR_RETURN(config,
+                           DashHandleConfiguration::loads(morphing["handles"].toObject(), radius));
+        return Loaded{ std::move(config), root["DV-Geometry"].toObject() };
+    }
+    return make_unexpected(
+        ErrorCode::InvalidArgument,
+        "This Set uses an unsupported morphing format. Recreate handles, fixed regions "
+        "and design variables, then save the Set before execution.");
+}
+QJsonObject DashHandleArchive::addressSample(const QJsonObject& sample,
+                                             const QJsonObject& definitions)
+{
+    QJsonObject out = sample;
+    for (auto it = out.begin(); it != out.end(); ++it) {
+        auto item = it.value().toObject();
+        auto meta = item["meta"].toObject();
+        const auto definition = definitions[it.key()].toObject()["meta"].toObject();
+        if (!meta.contains("set") && definition.contains("set")) {
+            meta["set"] = definition["set"];
+            meta["control"] = definition["control"];
+            item["meta"] = meta;
+            it.value() = item;
+        }
+    }
+    return out;
+}
