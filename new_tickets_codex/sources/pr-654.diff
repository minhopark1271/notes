diff --git a/controller/DashHandleSampling.cpp b/controller/DashHandleSampling.cpp
new file mode 100644
index 00000000..cf683cab
--- /dev/null
+++ b/controller/DashHandleSampling.cpp
@@ -0,0 +1,103 @@
+#include "controller/DashHandleSampling.h"
+#include <MeshOps/MeshOps/Morphing/Sampling.hpp>
+#include <cmath>
+#include <vtkDoubleArray.h>
+#include <vtkNew.h>
+#include <vtkPointData.h>
+#include <vtkPoints.h>
+#include <vtkPolyData.h>
+namespace {
+using Fields = std::vector<dash::mesh::HandleConfiguration>;
+dash::core::Result<std::vector<Fields>> convert(std::span<const DashHandleSampling::Input> inputs)
+{
+    std::vector<Fields> sets;
+    for (const auto& input : inputs) {
+        DASH_RETURN_IF_ERROR(input.baseline.validate());
+        Fields fields;
+        for (const auto& field : input.fields) {
+            DASH_RETURN_IF_ERROR(field.validate());
+            if (field.size() != input.baseline.size()) {
+                return dash::core::make_unexpected(dash::core::ErrorCode::InvalidArgument,
+                                                   "sample: field length differs from baseline");
+            }
+            vtkNew<vtkPoints> points;
+            points->SetDataTypeToDouble();
+            vtkNew<vtkDoubleArray> radii;
+            radii->SetName("SupportRadius");
+            vtkNew<vtkDoubleArray> motion;
+            motion->SetName("Displacement");
+            motion->SetNumberOfComponents(3);
+            for (std::size_t i = 0; i < field.size(); ++i) {
+                points->InsertNextPoint(input.baseline.positions[i].data());
+                radii->InsertNextValue(input.baseline.supportRadii[i]);
+                motion->InsertNextTuple(field.displacements[i].data());
+            }
+            vtkNew<vtkPolyData> data;
+            data->SetPoints(points);
+            data->GetPointData()->AddArray(radii);
+            data->GetPointData()->AddArray(motion);
+            DASH_REF_OR_RETURN(value, dash::mesh::HandleConfiguration::create(data));
+            fields.push_back(std::move(value));
+        }
+        sets.push_back(std::move(fields));
+    }
+    return sets;
+}
+}  // namespace
+dash::core::Result<void> DashHandleSampling::validate(const DashHandleSamplingPolicy& policy)
+{
+    if (!std::isfinite(policy.tolerance) || policy.tolerance <= 0 || policy.maximumHandles == 0
+        || !std::isfinite(policy.minimumImprovement) || policy.minimumImprovement < 0) {
+        return dash::core::make_unexpected(dash::core::ErrorCode::InvalidArgument,
+                                           "sampling policy requires positive tolerance/budget and "
+                                           "nonnegative finite improvement");
+    }
+    return {};
+}
+dash::core::Result<DashHandleSampling::Sampled> DashHandleSampling::sample(
+    std::span<const Input> pinned,
+    std::span<const Input> samplable,
+    const DashHandleSamplingPolicy& policy)
+{
+    DASH_RETURN_IF_ERROR(validate(policy));
+    DASH_REF_OR_RETURN(pinnedFields, convert(pinned));
+    DASH_REF_OR_RETURN(candidateFields, convert(samplable));
+    std::vector<dash::mesh::MotionFields> p, s;
+    for (const auto& fields : pinnedFields) {
+        p.emplace_back(fields);
+    }
+    for (const auto& fields : candidateFields) {
+        s.emplace_back(fields);
+    }
+    dash::mesh::SamplingPolicy options{};
+    options.tolerance = policy.tolerance;
+    options.maximum_handles = policy.maximumHandles;
+    options.stagnation_patience = policy.stagnationPatience;
+    options.minimum_improvement = policy.minimumImprovement;
+    options.solver.threads = policy.solverThreads;
+    options.allow_isolated_handles = policy.allowIsolatedHandles;
+    DASH_REF_OR_RETURN(result, dash::mesh::sample_handles(p, s, options));
+    Sampled out;
+    for (const auto& point : result.selection) {
+        out.selection.push_back({ point.set, point.point });
+    }
+    switch (result.summary.outcome) {
+        case dash::mesh::SamplingOutcome::Converged:
+            out.summary.outcome = DashSamplingSummary::Outcome::Converged;
+            break;
+        case dash::mesh::SamplingOutcome::HandleBudgetExhausted:
+            out.summary.outcome = DashSamplingSummary::Outcome::HandleBudgetExhausted;
+            break;
+        case dash::mesh::SamplingOutcome::Stagnated:
+            out.summary.outcome = DashSamplingSummary::Outcome::Stagnated;
+            break;
+        case dash::mesh::SamplingOutcome::CandidatesExhausted:
+            out.summary.outcome = DashSamplingSummary::Outcome::CandidatesExhausted;
+            break;
+    }
+    out.summary.sampledCount = result.summary.sampled_count;
+    out.summary.maximumMovingResidual = result.summary.maximum_moving_residual;
+    out.summary.maximumFixedResidual = result.summary.maximum_fixed_residual;
+    out.summary.maximumResidualPerField = std::move(result.summary.maximum_residual_per_field);
+    return out;
+}
diff --git a/controller/DashHandleSampling.h b/controller/DashHandleSampling.h
new file mode 100644
index 00000000..77bfc8c8
--- /dev/null
+++ b/controller/DashHandleSampling.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <CoreLib/Error.hpp>
+#include <cstddef>
+#include <span>
+#include <string>
+#include <vector>
+#include "controller/DashHandleBlock.h"
+
+// Persist this policy with the selected handles. All lengths use model units.
+struct DashHandleSamplingPolicy
+{
+    double tolerance = 1e-3;
+    std::size_t maximumHandles = 40;
+    std::size_t stagnationPatience = 8;
+    double minimumImprovement = 0.0;
+    std::size_t solverThreads = 0;
+    bool allowIsolatedHandles = true;
+};
+struct DashSamplingSummary
+{
+    enum class Outcome
+    {
+        Converged,
+        HandleBudgetExhausted,
+        Stagnated,
+        CandidatesExhausted
+    };
+    Outcome outcome = Outcome::Converged;
+    std::size_t sampledCount = 0;
+    double maximumMovingResidual = 0.0;
+    double maximumFixedResidual = 0.0;
+    std::vector<double> maximumResidualPerField;
+};
+namespace DashHandleSampling {
+// Every set supplies the same number of fields on its own baseline.
+[[nodiscard]] dash::core::Result<void> validate(const DashHandleSamplingPolicy& policy);
+struct Input
+{
+    DashHandleBlock baseline;
+    std::vector<DashHandleMotion> fields;
+};
+struct SelectedPoint
+{
+    std::size_t set;
+    std::size_t point;
+    bool operator==(const SelectedPoint&) const = default;
+};
+struct Sampled
+{
+    std::vector<SelectedPoint> selection;
+    DashSamplingSummary summary;
+};
+[[nodiscard]] dash::core::Result<Sampled> sample(std::span<const Input> pinned,
+                                                 std::span<const Input> samplable,
+                                                 const DashHandleSamplingPolicy& policy);
+}  // namespace DashHandleSampling
