-
-bool DashFixedMarkerSelection::ReadFrom(vtkPolyData* handlesVtp, vtkPoints* out)
-{
-    if (!handlesVtp || !out) {
-        return false;
-    }
-
-    auto* points = vtkDoubleArray::SafeDownCast(handlesVtp->GetFieldData()->GetArray(POINTS_ARRAY));
-    if (!points || points->GetNumberOfComponents() != 3) {
-        return false;
-    }
-
-    for (vtkIdType i = 0; i < points->GetNumberOfTuples(); ++i) {
-        double p[3];
-        points->GetTuple(i, p);
-        out->InsertNextPoint(p);
-    }
-    return true;
-}
-
-void DashFixedMarkerSelection::AppendMarkerPoints(const std::vector<vtkIdType>& surfaceIds,
-                                                  vtkPolyData* surface,
-                                                  vtkPoints* out)
-{
-    if (!surface || !out) {
-        return;
-    }
-
-    const vtkIdType numSurfacePoints = surface->GetNumberOfPoints();
-    for (vtkIdType surfId : surfaceIds) {
-        if (surfId >= 0 && surfId < numSurfacePoints) {
-            double p[3];
-            surface->GetPoint(surfId, p);
-            out->InsertNextPoint(p);
-        }
-    }
-}
