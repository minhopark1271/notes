+    void archiveRejectsSetupAndLoadsConfigurationWithoutVtp()
+    {
+        QTemporaryDir directory;
+        QVERIFY(directory.isValid());
+        const auto path = directory.filePath("set.json");
+        DashHandleSetup setup(5);
+        QVERIFY(setup.addPinned(groupEntry()));
+        auto write = [&](const QJsonObject& handles, const QJsonObject& dvs = QJsonObject{}) {
+            QFile file(path);
+            if (!file.open(QIODevice::WriteOnly)) {
+                return false;
+            }
+            return file.write(QJsonDocument(
+                                  QJsonObject{ { "Morphing",
+                                                 QJsonObject{ { "radius", 5 },
+                                                              { "handles", handles },
+                                                              { "handles_vtp", "missing.vtp" } } },
+                                               { "DV-Geometry", dvs } })
+                                  .toJson())
+                   > 0;
+        };
+        QVERIFY(write(setup.dumps({})));
+        QVERIFY(!DashHandleArchive::load(path));
+        auto config = std::move(setup).sample({});
+        QVERIFY(config);
+        QVERIFY(write(config->dumps(), config->dvGeometry()));
+        auto loaded = DashHandleArchive::load(path);
+        QVERIFY(loaded);
+        QCOMPARE(loaded->configuration.designBlock()->positions, config->designBlock()->positions);
+        QCOMPARE(loaded->dvGeometry, config->dvGeometry());
+        QVERIFY(write(QJsonObject{}));
+        QVERIFY(!DashHandleArchive::load(path));
