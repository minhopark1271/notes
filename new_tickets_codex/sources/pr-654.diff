new file mode 100644
index 00000000..7697777f
--- /dev/null
+++ b/view/common/DashSampledHandleTree.cpp
@@ -0,0 +1,114 @@
+#include "view/common/DashSampledHandleTree.h"
+#include <QSignalBlocker>
+#include <QCheckBox>
+#include <QDoubleSpinBox>
+#include <QHBoxLayout>
+#include <QTreeWidget>
+namespace {
+constexpr int entryRole = Qt::UserRole + 50;
+void tag(QTreeWidgetItem* item, const QString& name)
+{
+    item->setData(0, entryRole, name);
+    item->setData(0, Qt::UserRole + 2, -1);  // Never an interaction point id.
+    item->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+}
+}  // namespace
+QString DashSampledHandleTree::entryName(const QTreeWidgetItem* item)
+{
+    return item ? item->data(0, entryRole).toString() : QString{};
+}
+void DashSampledHandleTree::update(QTreeWidget* tree,
+                                   std::span<const DashHandleEntry> entries,
+                                   bool provisional,
+                                   Edit edit)
+{
+    const QSignalBlocker blocker(tree);
+    for (int i = tree->topLevelItemCount() - 1; i >= 0; --i) {
+        if (!entryName(tree->topLevelItem(i)).isEmpty()) {
+            delete tree->takeTopLevelItem(i);
+        }
+    }
+    for (const auto& entry : entries) {
+        if (!entry.isSampled()) {
+            continue;
+        }
+        auto block = DashHandleSets::block(entry);
+        if (!block) {
+            continue;
+        }
+        auto* group = new QTreeWidgetItem(tree);
+        tag(group, entry.name);
+        group->setText(0, QString::number(tree->topLevelItemCount()));
+        if (entry.isFixed()) {
+            group->setText(1, QObject::tr("Fixed"));
+        }
+        group->setText(2,
+                       QObject::tr("%1 (%2 handles, %3)")
+                           .arg(entry.name)
+                           .arg(block->size())
+                           .arg(provisional ? QObject::tr("Unconfirmed") : QObject::tr("Sampled")));
+        group->setToolTip(
+            2,
+            QObject::tr("Source: %1. Group members share this control and its bounds.")
+                .arg(*entry.sampledFrom));
+        for (const auto& control : entry.controls) {
+            auto* row = group;
+            if (entry.controls.size() > 1) {
+                row = new QTreeWidgetItem(group);
+                tag(row, entry.name);
+                row->setText(2, control.id());
+            }
+            auto* container = new QWidget(tree);
+            auto* layout = new QHBoxLayout(container);
+            layout->setContentsMargins(0, 0, 0, 0);
+            layout->setAlignment(Qt::AlignCenter);
+            auto* check = new QCheckBox(container);
+            check->setChecked(control.enabled);
+            check->setEnabled(!provisional);
+            layout->addWidget(check);
+            tree->setItemWidget(row, 1, container);
+            auto* lower = new QDoubleSpinBox(tree);
+            auto* upper = new QDoubleSpinBox(tree);
+            for (auto* spin : { lower, upper }) {
+                spin->setDecimals(8);
+                spin->setRange(-1e100, 1e100);
+                spin->setKeyboardTracking(false);
+                spin->setEnabled(!provisional);
+            }
+            lower->setValue(control.lower);
+            upper->setValue(control.upper);
+            tree->setItemWidget(row, 3, lower);
+            tree->setItemWidget(row, 4, upper);
+            if (edit && !provisional) {
+                auto previous = std::make_shared<DashHandleControl>(control);
+                auto submit =
+                    [edit, name = entry.name, id = control.id(), check, lower, upper, previous]() {
+                        if (!edit(name, id, check->isChecked(), lower->value(), upper->value())) {
+                            const QSignalBlocker a(check), b(lower), c(upper);
+                            check->setChecked(previous->enabled);
+                            lower->setValue(previous->lower);
+                            upper->setValue(previous->upper);
+                            return;
+                        }
+                        previous->enabled = check->isChecked();
+                        previous->lower = lower->value();
+                        previous->upper = upper->value();
+                    };
+                QObject::connect(check, &QCheckBox::toggled, tree, submit);
+                QObject::connect(lower, &QDoubleSpinBox::valueChanged, tree, submit);
+                QObject::connect(upper, &QDoubleSpinBox::valueChanged, tree, submit);
+            }
+        }
+        for (std::size_t i = 0; i < block->size(); ++i) {
+            auto* point = new QTreeWidgetItem(group);
+            tag(point, entry.name);
+            point->setText(2, QObject::tr("Handle %1").arg(i + 1));
+            const auto& p = block->positions[i];
+            point->setToolTip(2,
+                              QObject::tr("Position: (%1, %2, %3)")
+                                  .arg(p[0], 0, 'g', 17)
+                                  .arg(p[1], 0, 'g', 17)
+                                  .arg(p[2], 0, 'g', 17));
+        }
+    }
+}
