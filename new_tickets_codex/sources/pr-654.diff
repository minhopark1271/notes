+        block.positions = { { 0, 0, 0 }, { 1, 0, 0 } };
+        block.supportRadii = { 5, 5 };
+        auto entry = DashHandleSets::group(block);
+        QVERIFY(entry);
+        entry->name = "sampled";
+        entry->sampledFrom = "surface";
+        entry->controls[0].lower = -2;
+        entry->controls[0].upper = 3;
+        DashHandleSetup setup(5);
+        QVERIFY(setup.addPinned(*entry));
+        auto config = std::move(setup).sample({});
+        QVERIFY(config);
+        auto initial = config->dumps();
+        initial["pinned"] = QJsonArray{ DashHandleSets::dump(*entry) };
+        initial["unpinned"] = QJsonArray{ QJsonObject{
+            { "kind", "control" }, { "name", "surface" }, { "volumeIds", QJsonArray{ 0, 1 } } } };
+        config = DashHandleConfiguration::loads(initial, 5);
+        QVERIFY(config);
+        const auto original = *config;
+        QTreeWidget tree;
+        tree.setColumnCount(8);
+        DashSampledHandleTree::update(
+            &tree,
+            config->entries(),
+            false,
+            [&](const QString& name, const QString& control, bool enabled, double lo, double hi) {
+                if (name != "sampled") {
+                    return false;
+                }
+                auto next = config->withControlBounds(0, control, lo, hi);
+                if (!next) {
+                    return false;
+                }
+                next = next->withControlEnabled(0, control, enabled);
+                if (!next) {
+                    return false;
+                }
+                config = std::move(next);
+                return true;
+            });
+        auto* row = tree.topLevelItem(0);
+        QVERIFY(row);
+        QVERIFY(tree.itemWidget(row, 1));
+        auto* check = tree.itemWidget(row, 1)->findChild<QCheckBox*>();
+        auto* lower = qobject_cast<QDoubleSpinBox*>(tree.itemWidget(row, 3));
+        auto* upper = qobject_cast<QDoubleSpinBox*>(tree.itemWidget(row, 4));
+        QVERIFY(check && lower && upper);
+        lower->setValue(-4);
+        upper->setValue(6);
+        QCOMPARE(config->bounds(true)[0].value, 6.0);
+        auto moved = config->prescription(config->bounds(true));
+        QVERIFY(moved);
+        QCOMPARE(moved->displacements[0][0], 6.0);
+        check->setChecked(false);
+        QVERIFY(config->dvGeometry().isEmpty());
+        QVERIFY(config->bounds(true).empty());
+        auto stopped = config->prescription(config->bounds(true));
+        QVERIFY(stopped);
+        QCOMPARE(stopped->displacements[0][0], 0.0);
+        QVERIFY(!config->prescription({ { "sampled", "translation", 1.0 } }));
+        lower->setValue(10);  // Rejected; checkbox state and accepted bounds survive.
+        QCOMPARE(lower->value(), -4.0);
+        QVERIFY(!check->isChecked());
+        auto restored = DashHandleConfiguration::loads(config->dumps(), 5);
+        QVERIFY(restored);
+        QVERIFY(restored->dvGeometry().isEmpty());
+        QCOMPARE(restored->entries()[0].controls[0].lower, -4.0);
+        QVERIFY(original.entries()[0].controls[0].enabled);
+        QCOMPARE(original.entries()[0].controls[0].upper, 3.0);
+        check->setChecked(true);
+        QCOMPARE(config->dvGeometry().size(), 1);
+        QCOMPARE(config->bounds(false)[0].value, -4.0);
+        auto parts = config->ungroup(0);
+        QVERIFY(parts);
+        QCOMPARE(parts->entries()[0].controls[0].enabled, true);
+    }
+    void sampledRowsSurviveReloadWithoutLegacyIds()
+    {
+        DashHandleBlock block;
+        block.role = "design";
+        block.positions = { { 0, 0, 0 }, { 1, 0, 0 } };
+        block.supportRadii = { 5, 5 };
+        auto entry = DashHandleSets::group(block);
+        QVERIFY(entry);
+        entry->name = "auto-surface";
+        entry->sampledFrom = "surface";
+        entry->controls[0].lower = -2;
+        entry->controls[0].upper = 3;
+        const auto original = DashHandleSets::dump(*entry);
+        auto restored = DashHandleSets::load(original, 5);
+        QVERIFY(restored);
+        QTreeWidget tree;
+        tree.setColumnCount(8);
+        auto* explicitRow = new QTreeWidgetItem(&tree);
+        explicitRow->setData(0, Qt::UserRole + 2, 7);
+        std::vector<DashHandleEntry> entries{ *restored };
+        DashSampledHandleTree::update(&tree, entries);
+        QCOMPARE(tree.topLevelItemCount(), 2);
+        auto* sampled = tree.topLevelItem(1);
+        QCOMPARE(DashSampledHandleTree::entryName(sampled), QString("auto-surface"));
+        QCOMPARE(sampled->childCount(), 2);
+        QCOMPARE(qobject_cast<QDoubleSpinBox*>(tree.itemWidget(sampled, 3))->value(), -2.0);
+        QCOMPARE(qobject_cast<QDoubleSpinBox*>(tree.itemWidget(sampled, 4))->value(), 3.0);
+        QCOMPARE(sampled->child(0)->data(0, Qt::UserRole + 2).toInt(), -1);
+        QVERIFY(tree.itemWidget(sampled, 1)->findChild<QCheckBox*>()->isChecked());
+        QVERIFY(!(sampled->flags() & Qt::ItemIsEditable));
+        DashSampledHandleTree::update(&tree, entries, true);
+        QCOMPARE(tree.topLevelItemCount(), 2);
+        QVERIFY(tree.topLevelItem(1)->text(2).contains("Unconfirmed"));
+        QCOMPARE(tree.topLevelItem(0), explicitRow);
+        QCOMPARE(DashHandleSets::dump(entries[0]), original);
+        entries[0].sampledFrom.reset();  // Pin transfers display ownership to the editor.
+        DashSampledHandleTree::update(&tree, entries);
+        QCOMPARE(tree.topLevelItemCount(), 1);
+        entries[0].sampledFrom = "fixed";
+        entries[0].controls.clear();
+        DashSampledHandleTree::update(&tree, entries);
+        QCOMPARE(tree.topLevelItem(1)->text(1), QString("Fixed"));
+        DashSampledHandleTree::update(&tree, {});
+        QCOMPARE(tree.topLevelItemCount(), 1);
+    }
+};
