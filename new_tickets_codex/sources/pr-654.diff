-
-// FNV-1a 64. 암호학적 성질이 필요 없다 — 입력이 바뀌었는지만 보면 된다.
-constexpr std::uint64_t FNV_OFFSET = 1469598103934665603ULL;
-constexpr std::uint64_t FNV_PRIME = 1099511628211ULL;
-
-void HashBytes(std::uint64_t& h, const void* data, std::size_t n)
-{
-    const auto* p = static_cast<const unsigned char*>(data);
-    for (std::size_t i = 0; i < n; ++i) {
-        h ^= p[i];
-        h *= FNV_PRIME;
-    }
-}
-
-void HashU64(std::uint64_t& h, std::uint64_t v)
-{
-    HashBytes(h, &v, sizeof(v));
-}
-
-// double 은 비트 패턴으로 넣는다. 좌표 비교에 허용오차를 두지 않는 이유는,
-// 허용오차 안의 변화도 선별 결과를 바꿀 수 있기 때문이다 — 포아송 배제는
-// 거리 비교라 경계에서 갈린다.
-void HashDouble(std::uint64_t& h, double v)
-{
-    std::uint64_t bits = 0;
-    std::memcpy(&bits, &v, sizeof(bits));
-    HashU64(h, bits);
-}
-
-void HashPoint(std::uint64_t& h, vtkPolyData* pd, vtkIdType id)
-{
-    double p[3];
-    pd->GetPoint(id, p);
-    HashDouble(h, p[0]);
-    HashDouble(h, p[1]);
-    HashDouble(h, p[2]);
-}
-
-}  // namespace
-
-std::uint64_t DashFixedMarkerSelection::Fingerprint(const Inputs& in)
-{
-    if (!in.surface || !in.fixedSurfaceIds) {
-        return 0;
-    }
-
-    std::uint64_t h = FNV_OFFSET;
-
-    // surface 는 fixedSurfaceIds 자리의 좌표만 읽힌다
-    // (GenerateMarkerPointsFromSurfaceIds 의 2절). 전체를 해싱하면 결과를 바꾸지
-    // 않는 변화에 무효화가 걸린다.
-    const vtkIdType numSurfacePoints = in.surface->GetNumberOfPoints();
-    HashU64(h, static_cast<std::uint64_t>(numSurfacePoints));
-
-    HashU64(h, static_cast<std::uint64_t>(in.fixedSurfaceIds->size()));
-    for (vtkIdType id : *in.fixedSurfaceIds) {
-        HashU64(h, static_cast<std::uint64_t>(id));
-        // 생성기와 같은 경계 검사 — 범위 밖 id 는 좌표를 읽지 않는다.
-        if (id >= 0 && id < numSurfacePoints) {
-            HashPoint(h, in.surface, id);
-        }
-    }
-
-    const vtkIdType numHandlePoints =
-        in.designHandlePoints ? in.designHandlePoints->GetNumberOfPoints() : 0;
-    HashU64(h, static_cast<std::uint64_t>(numHandlePoints));
-    for (vtkIdType i = 0; i < numHandlePoints; ++i) {
-        HashPoint(h, in.designHandlePoints, i);
-    }
-
-    HashDouble(h, in.supportRadius);
-    // 상수가 바뀌면 저장된 선별도 무효다.
-    HashDouble(h, NonDesignUtils::MARKER_POISSON_SPACING);
-
-    // 0 은 "선별되지 않음" 의 자리라 지문이 될 수 없다.
-    return h == 0 ? 1 : h;
-}
-
-DashMarkerSet DashFixedMarkerSelection::select(const Inputs& in)
