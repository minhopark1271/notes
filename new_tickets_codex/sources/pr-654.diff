+using dash::core::ErrorCode;
+using dash::core::make_unexpected;
+using dash::core::Result;
+namespace {
+using Entry = DashHandleEntry;
+using Point = std::array<double, 3>;
+struct Region
+{
+    QString name;
+    DashHandleBlock points;
+    std::vector<Point> normals;
+    bool fixed = false;
+    std::size_t field = 0;
+};
+DashHandleSampling::Input training(const Region& r, std::size_t count)
+{
+    DashHandleSampling::Input out;
+    out.baseline = r.points;
+    out.fields.resize(count);
+    for (auto& f : out.fields) {
+        f.appendZeros(r.points.size());
+    }
+    if (!r.fixed) {
+        out.fields[r.field].displacements = r.normals;
+    }
+    return out;
+}
+}  // namespace
+Result<DashHandleConfiguration> DashHandleSetup::sample(const DashHandleSamplingPolicy& policy,
+                                                        const DashMorphingGeometry& geometry) &&
+{
+    // Resolve named fixed regions against this document generation before deriving surface ids.
+    DASH_REF_OR_RETURN(resolved, duplicate());
+    for (auto& region : resolved.unpinned_) {
+        if (DashRegionIsFixed(region)) {
+            std::vector<DashFixedRegion> specs{ std::get<DashFixedRegion>(region) };
+            DASH_REF_OR_RETURN(ids,
+                               resolveFixedVolumeIds(geometry.document(), geometry.part(), specs));
+            region = DashFixedRegion(DashVolumeIds{ DashRegionName(region), std::move(ids) });
+        }
+    }
+    DASH_REF_OR_RETURN(config,
+                       std::move(resolved).sampleVolume(policy, geometry.volume().inputMesh()));
+    config.unpinned_ = unpinned_;
+    config.setupKey_ = fingerprint();
+    pinned_.clear();
+    liveSets_.clear();
+    unpinned_.clear();
+    return config;
+}
+Result<DashHandleConfiguration> DashHandleSetup::sampleVolume(
+    const DashHandleSamplingPolicy& policy,
+    vtkUnstructuredGrid* volume) &&
+{
+    if (!volume || volume->GetNumberOfPoints() == 0) {
+        return make_unexpected(ErrorCode::InvalidArgument, "sample: missing volume mesh");
+    }
+    vtkNew<vtkDataSetSurfaceFilter> surface;
+    surface->SetInputData(volume);
+    vtkNew<vtkPolyDataNormals> normals;
+    normals->SetInputConnection(surface->GetOutputPort());
+    normals->SplittingOff();
+    normals->ComputePointNormalsOn();
+    normals->Update();
+    auto* mesh = normals->GetOutput();
+    // Nonlinear surface subdivision does not preserve every original point id.
+    // Match the editor's mapping after normals, including midside nodes.
+    vtkNew<vtkStaticPointLocator> locator;
+    locator->SetDataSet(volume);
+    locator->BuildLocator();
+    vtkNew<vtkIdTypeArray> ids;
+    ids->SetName(HandleArrayNames::volumePointIds);
+    ids->SetNumberOfTuples(mesh->GetNumberOfPoints());
+    for (vtkIdType i = 0; i < mesh->GetNumberOfPoints(); ++i) {
+        double point[3];
+        mesh->GetPoint(i, point);
+        ids->SetValue(i, locator->FindClosestPoint(point));
+    }
+    mesh->GetPointData()->AddArray(ids);
+    return std::move(*this).sample(policy, mesh, volume);
+}
+Result<DashHandleConfiguration> DashHandleSetup::sample(const DashHandleSamplingPolicy& policy,
+                                                        vtkPolyData* surface,
+                                                        vtkUnstructuredGrid* volume) &&
+{
+    DASH_RETURN_IF_ERROR(DashHandleSampling::validate(policy));
+    if (!std::isfinite(radius_) || radius_ <= 0) {
+        return make_unexpected(ErrorCode::InvalidArgument, "sample: invalid Set radius");
+    }
+    if (unpinned_.empty()) {
+        DashHandleConfiguration out;
+        out.radius_ = radius_;
+        out.policy_ = policy;
+        out.setupKey_ = fingerprint();
+        out.entries_ = std::move(pinned_);
+        liveSets_.clear();
+        return out;
+    }
+    std::vector<DashHandleSampling::Input> pinned;
+    std::vector<std::pair<int, QString>> controls;
+    std::set<Point> occupied;
+    for (int i = 0; i < int(pinned_.size()); ++i) {
+        DASH_REF_OR_RETURN(b, DashHandleSets::block(pinned_[i]));
+        for (const auto& point : b.positions) {
+            if (!occupied.insert(point).second) {
+                return make_unexpected(ErrorCode::InvalidArgument,
+                                       "sample: coincident pinned points");
+            }
+        }
+        pinned.push_back({ std::move(b), {} });
+        if (!pinned_[i].isFixed()) {
+            for (const auto& c : pinned_[i].controls) {
+                controls.emplace_back(i, c.name);
+            }
+        }
+    }
+    const std::size_t pinnedCount = occupied.size();
+    std::size_t fields = controls.size();
+    for (const auto& r : unpinned_) {
+        if (!DashRegionIsFixed(r)) {
+            ++fields;
+        }
+    }
+    fields = std::max<std::size_t>(fields, 1);
+    for (int i = 0; i < int(pinned.size()); ++i) {
+        pinned[i].fields.resize(fields);
+        for (auto& f : pinned[i].fields) {
+            f.appendZeros(pinned[i].baseline.size());
+        }
+        for (std::size_t k = 0; k < controls.size(); ++k) {
+            if (controls[k].first == i) {
+                DASH_REF_OR_RETURN(
+                    m,
+                    DashHandleSets::motion(pinned_[i],
+                                           { { pinned_[i].name, controls[k].second, 1.0 } }));
+                pinned[i].fields[k] = std::move(m);
+            }
+        }
+    }
+    std::map<vtkIdType, std::pair<Point, Point>> surfacePoints;
+    if (surface) {
+        auto* ids = surface->GetPointData()->GetArray(HandleArrayNames::volumePointIds);
+        auto* normals = surface->GetPointData()->GetNormals();
+        if (ids && normals && ids->GetNumberOfTuples() == surface->GetNumberOfPoints()
+            && normals->GetNumberOfTuples() == surface->GetNumberOfPoints()) {
+            for (vtkIdType i = 0; i < surface->GetNumberOfPoints(); ++i) {
+                Point p, n;
+                surface->GetPoint(i, p.data());
+                normals->GetTuple(i, n.data());
+                surfacePoints.emplace(vtkIdType(ids->GetTuple1(i)), std::make_pair(p, n));
+            }
+        }
+    }
+    std::vector<Region> regions(unpinned_.size());
+    std::size_t nextField = controls.size();
+    // Fixed regions take precedence over overlapping surface regions.
+    for (int pass = 0; pass < 2; ++pass) {
+        for (std::size_t i = 0; i < unpinned_.size(); ++i) {
+            const auto& spec = unpinned_[i];
+            const bool fixed = DashRegionIsFixed(spec);
+            if (fixed != (pass == 0)) {
+                continue;
+            }
+            auto& region = regions[i];
+            region.name = DashRegionName(spec);
+            region.fixed = fixed;
+            region.points.role = fixed ? "marker" : "design";
+            std::vector<vtkIdType> ids;
+            if (fixed) {
+                std::vector<DashFixedRegion> specs{ std::get<DashFixedRegion>(spec) };
+                DASH_REF_OR_RETURN(resolved, resolveFixedVolumeIds(volume, specs));
+                ids = std::move(resolved);
+            } else {
+                ids = std::get<DashControlRegion>(spec).volumeIds.ids;
+                region.field = nextField++;
+            }
+            for (auto id : ids) {
+                Point point{}, normal{};
+                if (fixed) {
+                    if (!volume || id < 0 || id >= volume->GetNumberOfPoints()) {
+                        return make_unexpected(ErrorCode::InvalidArgument,
+                                               "sample: invalid fixed point");
+                    }
+                    volume->GetPoint(id, point.data());
+                } else {
+                    auto it = surfacePoints.find(id);
+                    if (it == surfacePoints.end()) {
+                        return make_unexpected(ErrorCode::InvalidArgument,
+                                               "sample: surface region contains a non-surface "
+                                               "volume id or lacks normals");
+                    }
+                    point = it->second.first;
+                    normal = it->second.second;
+                }
+                if (!occupied.insert(point).second) {
+                    continue;
+                }
+                region.points.positions.push_back(point);
+                region.points.supportRadii.push_back(radius_);
+                region.normals.push_back(normal);
+            }
+        }
+    }
+    Region seeds;
+    seeds.points.role = "design";
+    // Bootstrap only when there are fewer than two explicit points. Choose
+    // extrema of the candidate bounding box; tie breaking is deterministic.
+    std::vector<std::pair<std::size_t, std::size_t>> seedSources;
+    for (std::size_t need = pinnedCount; need < 2; ++need) {
+        bool found = false;
+        std::pair<std::size_t, std::size_t> best{};
+        Point extreme{};
+        for (std::size_t i = 0; i < regions.size(); ++i) {
+            if (!regions[i].fixed) {
+                for (std::size_t j = 0; j < regions[i].points.size(); ++j) {
+                    const auto p = regions[i].points.positions[j];
+                    if (std::find(seedSources.begin(), seedSources.end(), std::pair{ i, j })
+                        != seedSources.end()) {
+                        continue;
+                    }
+                    if (!found || (need == 0 ? p < extreme : extreme < p)) {
+                        found = true;
+                        best = { i, j };
+                        extreme = p;
+                    }
+                }
+            }
+        }
+        if (!found) {
+            return make_unexpected(
+                ErrorCode::InvalidArgument,
+                "sample requires at least two distinct handles or surface candidates");
+        }
+        seedSources.push_back(best);
+    }
+    for (auto [i, j] : seedSources) {
+        Region seed;
+        seed.points.role = "design";
+        seed.points.positions = { regions[i].points.positions[j] };
+        seed.points.supportRadii = { radius_ };
+        seed.normals = { regions[i].normals[j] };
+        seed.field = regions[i].field;
+        pinned.push_back(training(seed, fields));
+        seeds.points.positions.push_back(seed.points.positions[0]);
+        seeds.points.supportRadii.push_back(radius_);
+        seeds.normals.push_back(seed.normals[0]);
+    }
+    std::vector<DashHandleSampling::Input> candidates;
+    std::vector<Region> selectedRegions;
+    for (std::size_t i = 0; i < regions.size(); ++i) {
+        Region r = regions[i];
+        r.points.positions.clear();
+        r.points.supportRadii.clear();
+        r.normals.clear();
+        for (std::size_t j = 0; j < regions[i].points.size(); ++j) {
+            if (std::find(seedSources.begin(), seedSources.end(), std::pair{ i, j })
+                != seedSources.end()) {
+                continue;
+            }
+            r.points.positions.push_back(regions[i].points.positions[j]);
+            r.points.supportRadii.push_back(radius_);
+            r.normals.push_back(regions[i].normals[j]);
+        }
+        if (!r.points.empty()) {
+            candidates.push_back(training(r, fields));
+            selectedRegions.push_back(std::move(r));
+        }
+    }
+    if (policy.maximumHandles < seedSources.size()) {
+        return make_unexpected(ErrorCode::InvalidArgument,
+                               "sampling budget is smaller than required seeds");
+    }
+    std::vector<Region> chosen = regions;
+    for (auto& r : chosen) {
+        r.points.positions.clear();
+        r.points.supportRadii.clear();
+        r.normals.clear();
+    }
+    for (auto [i, j] : seedSources) {
+        chosen[i].points.positions.push_back(regions[i].points.positions[j]);
+        chosen[i].points.supportRadii.push_back(radius_);
+        chosen[i].normals.push_back(regions[i].normals[j]);
+    }
+    DashSamplingSummary summary;
+    if (!candidates.empty()) {
+        auto budget = policy;
+        const bool seedOnly = budget.maximumHandles == seeds.points.size();
+        budget.maximumHandles = seedOnly ? 1 : budget.maximumHandles - seeds.points.size();
+        // An immediate-convergence query reports the seed basis residual without selecting points.
+        if (seedOnly) {
+            budget.tolerance = std::numeric_limits<double>::max();
+        }
+        DASH_REF_OR_RETURN(sampled, DashHandleSampling::sample(pinned, candidates, budget));
+        summary = std::move(sampled.summary);
+        if (seedOnly
+            && std::max(summary.maximumMovingResidual, summary.maximumFixedResidual)
+                   > policy.tolerance) {
+            summary.outcome = DashSamplingSummary::Outcome::HandleBudgetExhausted;
+        }
+        for (const auto& selected : sampled.selection) {
+            const auto& region = selectedRegions[selected.set];
+            auto& target = *std::find_if(
+                chosen.begin(), chosen.end(), [&](const auto& r) { return r.name == region.name; });
+            target.points.positions.push_back(region.points.positions[selected.point]);
+            target.points.supportRadii.push_back(radius_);
+            target.normals.push_back(region.normals[selected.point]);
+        }
+    }
+    summary.sampledCount = 0;
+    for (const auto& r : chosen) {
+        summary.sampledCount += r.points.size();
+    }
+    DashHandleConfiguration out;
+    out.radius_ = radius_;
+    out.policy_ = policy;
+    out.summary_ = std::move(summary);
+    out.setupKey_ = fingerprint();
+    out.entries_ = pinned_;
+    out.unpinned_ = unpinned_;
+    std::set<QString> names;
+    for (const auto& e : out.entries_) {
+        names.insert(e.name);
+    }
+    for (const auto& r : chosen) {
+        if (r.points.empty()) {
+            continue;
+        }
+        const auto field = r.fixed ? std::span<const Point>{} : std::span<const Point>(r.normals);
+        DASH_REF_OR_RETURN(entry, DashHandleSets::group(r.points, field));
+        entry.sampledFrom = r.name;
+        const QString base =
+            (r.fixed ? QStringLiteral("fixed-") : QStringLiteral("auto-")) + r.name;
+        entry.name = base;
+        for (int suffix = 1; !names.insert(entry.name).second; ++suffix) {
+            entry.name = base + QStringLiteral("-%1").arg(suffix);
+        }
+        if (!r.fixed) {
+            entry.controls[0].lower = -1;
+            entry.controls[0].upper = 1;
+        }
+        out.entries_.push_back(std::move(entry));
+    }
+    // Commit the transition only after every fallible operation has succeeded.
+    pinned_.clear();
+    liveSets_.clear();
+    unpinned_.clear();
+    return out;
+}
