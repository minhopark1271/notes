+++ b/controller/DashHandleStateJson.cpp
@@ -0,0 +1,442 @@
+#include "controller/DashHandleState.h"
+#include <MeshOps/MeshOps/Morphing/BoxHandles.hpp>
+#include <MeshOps/MeshOps/Morphing/GroupHandles.hpp>
+#include <MeshOps/MeshOps/Morphing/SectionFrameHandles.hpp>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <cmath>
+#include <algorithm>
+#include <limits>
+#include <set>
+using dash::core::ErrorCode;
+using dash::core::make_unexpected;
+using dash::core::Result;
+namespace {
+using Entry = DashHandleEntry;
+const QStringList outcomes = { "Converged",
+                               "HandleBudgetExhausted",
+                               "Stagnated",
+                               "CandidatesExhausted" };
+QJsonObject policyJson(const DashHandleSamplingPolicy& p)
+{
+    return { { "tolerance", p.tolerance },
+             { "maximumHandles", qint64(p.maximumHandles) },
+             { "stagnationPatience", qint64(p.stagnationPatience) },
+             { "minimumImprovement", p.minimumImprovement },
+             { "solverThreads", qint64(p.solverThreads) },
+             { "allowIsolatedHandles", p.allowIsolatedHandles } };
+}
+QJsonArray regionJson(const std::vector<DashUnpinnedRegion>& regions)
+{
+    QJsonArray out;
+    for (const auto& r : regions) {
+        QJsonObject j{ { "kind", !DashRegionIsFixed(r) ? "control" : "fixed" },
+                       { "name", DashRegionName(r) } };
+        const auto spec = !DashRegionIsFixed(r)
+                              ? DashFixedRegion(std::get<DashControlRegion>(r).volumeIds)
+                              : std::get<DashFixedRegion>(r);
+        QJsonObject v;
+        std::visit(
+            [&](const auto& item) {
+                using T = std::decay_t<decltype(item)>;
+                if constexpr (std::is_same_v<T, DashNodeSetRef>) {
+                    v = { { "kind", "nodeSet" }, { "setName", item.setName } };
+                } else if constexpr (std::is_same_v<T, DashGridMaskRef>) {
+                    v = { { "kind", "mask" }, { "arrayName", item.arrayName } };
+                } else {
+                    QJsonArray ids;
+                    if constexpr (std::is_same_v<T, DashVolumeIds>) {
+                        for (auto id : item.ids) {
+                            ids.append(qint64(id));
+                        }
+                        v = { { "kind", "volumeIds" }, { "name", item.name }, { "ids", ids } };
+                    } else {
+                        for (auto id : item.labels) {
+                            ids.append(qint64(id));
+                        }
+                        v = { { "kind", "labels" }, { "name", item.name }, { "ids", ids } };
+                    }
+                }
+            },
+            spec);
+        if (!DashRegionIsFixed(r)) {
+            j.insert("volumeIds", v["ids"]);
+        } else {
+            j.insert("spec", v);
+        }
+        out.append(j);
+    }
+    return out;
+}
+Result<std::vector<DashUnpinnedRegion>> readRegions(const QJsonArray& json)
+{
+    std::vector<DashUnpinnedRegion> out;
+    for (const auto& value : json) {
+        const auto j = value.toObject();
+        const auto kind = j["kind"].toString();
+        if (kind != "control" && kind != "fixed") {
+            return make_unexpected(ErrorCode::InvalidArgument, "unknown unpinned region kind");
+        }
+        DashUnpinnedRegion r;
+        const auto name = j["name"].toString();
+        const auto spec = j["spec"].toObject();
+        const auto type = spec["kind"].toString();
+        if (kind == "control" || type == "volumeIds" || type == "labels") {
+            const auto raw = kind == "control" ? j["volumeIds"] : spec["ids"];
+            if (!raw.isArray()) {
+                return make_unexpected(ErrorCode::InvalidArgument, "region requires an id array");
+            }
+            DashVolumeIds ids{ name, {} };
+            for (const auto& id : raw.toArray()) {
+                double d = id.toDouble(-1);
+                if (!std::isfinite(d) || d < 0 || std::floor(d) != d
+                    || d > double(std::numeric_limits<vtkIdType>::max())) {
+                    return make_unexpected(ErrorCode::InvalidArgument, "invalid region id");
+                }
+                ids.ids.push_back(vtkIdType(d));
+            }
+            if (kind == "control") {
+                r = DashControlRegion{ name, std::move(ids) };
+            } else if (type == "volumeIds") {
+                r = DashFixedRegion(std::move(ids));
+            } else {
+                DashNodeLabels labels{ name, {} };
+                for (auto id : ids.ids) {
+                    if (id > std::numeric_limits<uint32_t>::max()) {
+                        return make_unexpected(ErrorCode::InvalidArgument, "invalid node label");
+                    }
+                    labels.labels.push_back(uint32_t(id));
+                }
+                r = DashFixedRegion(std::move(labels));
+            }
+        } else if (type == "nodeSet") {
+            r = DashFixedRegion(DashNodeSetRef{ spec["setName"].toString() });
+        } else if (type == "mask") {
+            r = DashFixedRegion(DashGridMaskRef{ spec["arrayName"].toString() });
+        } else {
+            return make_unexpected(ErrorCode::InvalidArgument, "unknown fixed region spec");
+        }
+        if (DashRegionName(r).isEmpty()
+            || std::any_of(out.begin(), out.end(), [&](const auto& previous) {
+                   return DashRegionName(previous) == DashRegionName(r);
+               })) {
+            return make_unexpected(ErrorCode::InvalidArgument, "empty or duplicate region name");
+        }
+        out.push_back(std::move(r));
+    }
+    return out;
+}
+}  // namespace
+DashHandleSamplingPolicy DashHandleSets::policyFromJson(const QJsonObject& j)
+{
+    DashHandleSamplingPolicy p;
+    p.tolerance = j["tolerance"].toDouble(1e-3);
+    const auto count = [&](const char* key, qint64 fallback) {
+        const auto x = j[key].toDouble(double(fallback));
+        return std::isfinite(x) && x >= 0 && std::floor(x) == x
+                       && x < double(std::numeric_limits<qint64>::max())
+                   ? std::size_t(x)
+                   : std::size_t(0);
+    };
+    p.maximumHandles = count("maximumHandles", 40);
+    p.stagnationPatience = count("stagnationPatience", 8);
+    p.solverThreads = count("solverThreads", 0);
+    p.minimumImprovement = j["minimumImprovement"].toDouble(0);
+    p.allowIsolatedHandles = j["allowIsolatedHandles"].toBool(true);
+    return p;
+}
+QJsonObject DashHandleControl::dump() const
+{
+    return { { "name", name },
+             { "lower", lower },
+             { "upper", upper },
+             { "enabled", enabled },
+             { "direction", QJsonArray{ direction[0], direction[1], direction[2] } } };
+}
+Result<DashHandleControl> DashHandleControl::load(const QJsonObject& j)
+{
+    DashHandleControl c;
+    c.name = j["name"].toString();
+    if (j.contains("enabled") && !j["enabled"].isBool()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid control enabled flag");
+    }
+    c.enabled = j["enabled"].toBool(true);
+    c.lower = j["lower"].toDouble(std::numeric_limits<double>::quiet_NaN());
+    c.upper = j["upper"].toDouble(std::numeric_limits<double>::quiet_NaN());
+    const auto direction = j["direction"].toArray();
+    if (c.name.isEmpty() || !std::isfinite(c.lower) || !std::isfinite(c.upper) || c.lower > c.upper
+        || direction.size() != 3) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid control metadata");
+    }
+    for (int i = 0; i < 3; ++i) {
+        c.direction[i] = direction[i].toDouble(std::numeric_limits<double>::quiet_NaN());
+        if (!std::isfinite(c.direction[i])) {
+            return make_unexpected(ErrorCode::InvalidArgument, "invalid control direction");
+        }
+    }
+    return c;
+}
+QJsonObject DashHandleSets::dump(const Entry& e)
+{
+    QJsonArray controls;
+    for (const auto& c : e.controls) {
+        controls.append(c.dump());
+    }
+    QJsonArray owners;
+    for (int id : e.ownerIds) {
+        owners.append(id);
+    }
+    QJsonObject out{ { "kind",
+                       e.isGroup()     ? "group"
+                       : e.isSection() ? "section"
+                                       : "box" },
+                     { "name", e.name },
+                     { "controls", controls },
+                     { "ownerIds", owners },
+                     { "dump",
+                       QString::fromStdString(
+                           std::visit([](const auto& p) { return p->dump(); }, e.set)) } };
+    if (e.sampledFrom) {
+        out["sampledFrom"] = *e.sampledFrom;
+    }
+    return out;
+}
+Result<Entry> DashHandleSets::load(const QJsonObject& j, double radius)
+{
+    if (!std::isfinite(radius) || radius <= 0) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid Set radius");
+    }
+    Entry e;
+    const auto kind = j["kind"].toString();
+    e.name = j["name"].toString();
+    if (e.name.isEmpty() || !j["dump"].isString() || !j["controls"].isArray()) {
+        return make_unexpected(ErrorCode::InvalidArgument, "invalid handle entry metadata");
+    }
+    if (j.contains("sampledFrom")) {
+        if (!j["sampledFrom"].isString() || j["sampledFrom"].toString().isEmpty()) {
+            return make_unexpected(ErrorCode::InvalidArgument, "invalid sampled origin");
+        }
+        e.sampledFrom = j["sampledFrom"].toString();
+    }
+    const auto text = j["dump"].toString().toStdString();
+    if (kind == "group") {
+        DASH_REF_OR_RETURN(set, dash::mesh::GroupHandles::load(text));
+        auto options = set->base_options();
+        if (std::any_of(options.support_radii.begin(),
+                        options.support_radii.end(),
+                        [radius](double r) { return r != radius; })) {
+            options.support_radii.assign(options.positions.size(), radius);
+            DASH_REF_OR_RETURN(rebuilt, dash::mesh::GroupHandles::create(std::move(options)));
+            if (set->control() == dash::mesh::GroupControl::FieldRate) {
+                DASH_RETURN_IF_ERROR(rebuilt->set_rate(set->rate()));
+            } else {
+                DASH_RETURN_IF_ERROR(rebuilt->set_translation(set->translation()));
+            }
+            set = std::move(rebuilt);
+        }
+        e.set = std::move(set);
+    } else if (kind == "section") {
+        DASH_REF_OR_RETURN(set, dash::mesh::SectionFrameHandles::load(text));
+        if (set->support_radius() != radius) {
+            auto options = set->base_options();
+            options.support_radius = radius;
+            DASH_REF_OR_RETURN(rebuilt, dash::mesh::SectionFrameHandles::create(options));
+            DASH_RETURN_IF_ERROR(rebuilt->set_edges(set->edges()));
+            set = std::move(rebuilt);
+        }
+        e.set = std::move(set);
+    } else if (kind == "box") {
+        DASH_REF_OR_RETURN(set, dash::mesh::BoxHandles::load(text));
+        if (set->support_radius() != radius) {
+            auto options = set->base_options();
+            options.support_radius = radius;
+            DASH_REF_OR_RETURN(rebuilt, dash::mesh::BoxHandles::create(options));
+            DASH_RETURN_IF_ERROR(rebuilt->set_faces(set->faces()));
+            set = std::move(rebuilt);
+        }
+        e.set = std::move(set);
+    } else {
+        return make_unexpected(ErrorCode::InvalidArgument, "unknown handle kind");
+    }
+    std::set<QString> names;
+    for (const auto& v : j["controls"].toArray()) {
+        DASH_REF_OR_RETURN(c, DashHandleControl::load(v.toObject()));
+        if (!names.insert(c.name).second) {
+            return make_unexpected(ErrorCode::InvalidArgument, "duplicate control id");
+        }
+        e.controls.push_back(c);
+    }
+    for (const auto& id : j["ownerIds"].toArray()) {
+        e.ownerIds.push_back(id.toInt(-1));
+    }
+    DASH_RETURN_IF_ERROR(block(e));
+    DashDvValues zero;
+    for (const auto& c : e.controls) {
+        zero.push_back({ e.name, c.name, 0 });
+    }
+    DASH_RETURN_IF_ERROR(motion(e, zero));
+    return e;
+}
+QJsonObject DashHandleSetup::dumps(const DashHandleSamplingPolicy& policy) const
+{
+    QJsonArray pinned;
+    for (const auto& e : pinned_) {
+        pinned.append(DashHandleSets::dump(e));
+    }
+    return { { "version", 1 },
+             { "state", "setup" },
+             { "policy", policyJson(policy) },
+             { "pinned", pinned },
+             { "unpinned", regionJson(unpinned_) } };
+}
+Result<DashHandleSetup> DashHandleSetup::loads(const QJsonObject& j, double radius)
+{
+    if (j["version"].toDouble(-1) != 1 || j["state"] != "setup" || !j["pinned"].isArray()
+        || !j["unpinned"].isArray() || !j["policy"].isObject()) {
+        return make_unexpected(ErrorCode::InvalidArgument,
+                               "invalid or unsupported handle setup version/state");
+    }
+    DASH_RETURN_IF_ERROR(
+        DashHandleSampling::validate(DashHandleSets::policyFromJson(j["policy"].toObject())));
+    DashHandleSetup out(radius);
+    for (const auto& value : j["pinned"].toArray()) {
+        DASH_REF_OR_RETURN(e, DashHandleSets::load(value.toObject(), radius));
+        if (e.isSampled()) {
+            return make_unexpected(ErrorCode::InvalidArgument, "setup contains sampled entry");
+        }
+        DASH_RETURN_IF_ERROR(out.addPinned(std::move(e)));
+    }
+    DASH_REF_OR_RETURN(regions, readRegions(j["unpinned"].toArray()));
+    out.unpinned_ = std::move(regions);
+    return out;
+}
+QJsonObject DashHandleConfiguration::dumps() const
+{
+    QJsonArray pinned;
+    for (const auto& e : entries_) {
+        pinned.append(DashHandleSets::dump(e));
+    }
+    QJsonObject j{ { "version", 1 },
+                   { "state", "configuration" },
+                   { "policy", policyJson(policy_) },
+                   { "pinned", pinned },
+                   { "unpinned", regionJson(unpinned_) },
+                   { "setupKey", QString::number(setupKey_, 16) } };
+    if (summary_) {
+        QJsonArray residuals;
+        for (double r : summary_->maximumResidualPerField) {
+            residuals.append(r);
+        }
+        j.insert("summary",
+                 QJsonObject{ { "outcome", outcomes[int(summary_->outcome)] },
+                              { "sampledCount", qint64(summary_->sampledCount) },
+                              { "maximumMovingResidual", summary_->maximumMovingResidual },
+                              { "maximumFixedResidual", summary_->maximumFixedResidual },
+                              { "maximumResidualPerField", residuals } });
+    }
+    return j;
+}
+Result<DashHandleConfiguration> DashHandleConfiguration::loads(const QJsonObject& j, double radius)
+{
+    if (j["version"].toDouble(-1) != 1 || j["state"] != "configuration" || !j["pinned"].isArray()
+        || !j["unpinned"].isArray() || !j["policy"].isObject()) {
+        return make_unexpected(
+            ErrorCode::InvalidArgument,
+            "invalid/unsupported handle configuration; setup must be sampled before execution");
+    }
+    DashHandleConfiguration out;
+    out.radius_ = radius;
+    out.policy_ = DashHandleSets::policyFromJson(j["policy"].toObject());
+    DASH_RETURN_IF_ERROR(DashHandleSampling::validate(out.policy_));
+    DASH_REF_OR_RETURN(regions, readRegions(j["unpinned"].toArray()));
+    out.unpinned_ = std::move(regions);
+    std::set<QString> names;
+    for (const auto& value : j["pinned"].toArray()) {
+        DASH_REF_OR_RETURN(e, DashHandleSets::load(value.toObject(), radius));
+        if (!names.insert(e.name).second) {
+            return make_unexpected(ErrorCode::InvalidArgument, "duplicate handle entry name");
+        }
+        if (e.sampledFrom
+            && std::none_of(out.unpinned_.begin(), out.unpinned_.end(), [&](const auto& r) {
+                   return DashRegionName(r) == *e.sampledFrom;
+               })) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "sampled entry refers to missing region");
+        }
+        out.entries_.push_back(std::move(e));
+    }
+    out.setupKey_ = j["setupKey"].toString().toULongLong(nullptr, 16);
+    if (j.contains("summary")) {
+        out.summary_.emplace();
+        const auto summary = j["summary"].toObject();
+        int outcome = outcomes.indexOf(summary["outcome"].toString());
+        const double count = summary["sampledCount"].toDouble(-1);
+        if (outcome < 0 || count < 0 || !std::isfinite(count)
+            || count >= double(std::numeric_limits<std::size_t>::max())
+            || std::floor(count) != count) {
+            return make_unexpected(ErrorCode::InvalidArgument, "invalid sampling summary");
+        }
+        out.summary_->outcome = DashSamplingSummary::Outcome(outcome);
+        out.summary_->sampledCount = std::size_t(count);
+        out.summary_->maximumMovingResidual = summary["maximumMovingResidual"].toDouble(-1);
+        out.summary_->maximumFixedResidual = summary["maximumFixedResidual"].toDouble(-1);
+        if (out.summary_->maximumMovingResidual < 0 || out.summary_->maximumFixedResidual < 0) {
+            return make_unexpected(ErrorCode::InvalidArgument, "invalid sampling residual");
+        }
+        for (const auto& r : summary["maximumResidualPerField"].toArray()) {
+            if (!r.isDouble() || r.toDouble() < 0) {
+                return make_unexpected(ErrorCode::InvalidArgument, "invalid field residual");
+            }
+            out.summary_->maximumResidualPerField.push_back(r.toDouble());
+        }
+    }
+    return out;
+}
+QJsonObject DashHandleConfiguration::dvGeometry() const
+{
+    QJsonObject out;
+    int number = 1;
+    for (int i = 0; i < int(entries_.size()); ++i) {
+        if (!entries_[i].isFixed()) {
+            for (const auto& c : entries_[i].controls) {
+                if (!c.enabled) {
+                    continue;
+                }
+                QJsonObject meta{ { "set", entries_[i].name }, { "control", c.name },
+                                  { "min", c.lower },          { "max", c.upper },
+                                  { "default", 0.0 },          { "design value", 0.0 } };
+                out.insert(QStringLiteral("param%1").arg(number++),
+                           QJsonObject{ { "boolean", true },
+                                        { "type", "continuous" },
+                                        { "name", entries_[i].name + " (" + c.name + ")" },
+                                        { "meta", meta } });
+            }
+        }
+    }
+    return out;
+}
+Result<DashDvValues> DashHandleConfiguration::values(const QJsonObject& json) const
+{
+    DashDvValues out;
+    for (auto it = json.begin(); it != json.end(); ++it) {
+        const auto item = it.value().toObject();
+        const auto j = item.contains("meta") ? item["meta"].toObject() : item;
+        const double value =
+            j.contains("design value")
+                ? j["design value"].toDouble(std::numeric_limits<double>::quiet_NaN())
+                : j["value"].toDouble(std::numeric_limits<double>::quiet_NaN());
+        if (!j["set"].isString() || !j["control"].isString()) {
+            return make_unexpected(ErrorCode::InvalidArgument,
+                                   "DV requires a set name and control id");
+        }
+        const auto name = j["set"].toString();
+        const auto entry = std::find_if(
+            entries_.begin(), entries_.end(), [&](const auto& e) { return e.name == name; });
+        if (name.isEmpty() || entry == entries_.end()) {
+            return make_unexpected(ErrorCode::InvalidArgument, "unknown DV set name");
+        }
+        out.push_back({ name, j["control"].toString(), value });
+    }
+    DASH_RETURN_IF_ERROR(prescription(out));
+    return out;
+}
