+                                                std::vector<int>* outOriginMap)
+{
+    auto* inputHandles = const_cast<vtkPolyData*>(handles);
+    // outOriginMap is used to restore ids to track failed element on mesh quality check.
+
+    vtkSmartPointer<vtkPoints> initialPoints = vtkSmartPointer<vtkPoints>::New();
+    initialPoints->SetDataTypeToDouble();
+
+    if (!inputHandles) {
+        return initialPoints;
+    }
+
+    vtkIntArray* activeStatus =
+        vtkIntArray::SafeDownCast(inputHandles->GetPointData()->GetArray(HandleArrayNames::STATUS));
+    vtkIntArray* handleTypes = vtkIntArray::SafeDownCast(
+        inputHandles->GetPointData()->GetArray(HandleArrayNames::HANDLETYPE));
+
+    // Extract initial points and compute target points using input handle data
+    for (vtkIdType pid = 0; pid < inputHandles->GetNumberOfPoints(); pid++) {
+        int isActive = activeStatus->GetTuple1(pid);
+        if (isActive == 0) {
+            continue;  // skip inactive handles
+        }
+
+        // 설계변수로 체크되지 않은 핸들은 제외한다(프리뷰 경로).
+        if (includeHandleIds
+            && includeHandleIds->find(static_cast<int>(pid)) == includeHandleIds->end()) {
+            continue;
+        }
+
+        int hType = handleTypes->GetValue(pid);
+
+        if (hType == 1) {
+            double p[3];
+            inputHandles->GetPoint(pid, p);
+            initialPoints->InsertNextPoint(p);  // initial point
+
+            if (outOriginMap) {
+                outOriginMap->push_back(pid);
+            }
+        } else if (hType == 2) {
+            auto boundArray = vtkDoubleArray::SafeDownCast(
+                inputHandles->GetPointData()->GetArray(HandleArrayNames::BOUND));
+            auto l2gArray = vtkDoubleArray::SafeDownCast(
+                inputHandles->GetPointData()->GetArray(HandleArrayNames::L2G));
+
+            double localBound[6], matData[16];
+            boundArray->GetTuple(pid, localBound);  // [xmin, xmax, ymin, ymax, zmid, zmid]
+            l2gArray->GetTuple(pid, matData);
+
+            vtkNew<vtkMatrix4x4> mat;
+            mat->DeepCopy(matData);
+            vtkNew<vtkTransform> localToGlobal;
+            localToGlobal->SetMatrix(mat);
+
+            double localInitXmin = localBound[0], localInitXmax = localBound[1];
+            double localInitYmin = localBound[2], localInitYmax = localBound[3];
+            double localZ = localBound[4];
+
+            int nx = 5;
+            int ny = 5;
+
+            vtkNew<vtkPoints> localInitGridPoints;
+
+            for (int iy = 0; iy < ny; ++iy) {
+                double ty = static_cast<double>(iy) / static_cast<double>(ny - 1);
+                double initY = localInitYmin + ty * (localInitYmax - localInitYmin);
+
+                for (int ix = 0; ix < nx; ++ix) {
+                    double tx = static_cast<double>(ix) / static_cast<double>(nx - 1);
+                    double initX = localInitXmin + tx * (localInitXmax - localInitXmin);
+                    localInitGridPoints->InsertNextPoint(initX, initY, localZ);
+                }
+            }
+
+            vtkNew<vtkPoints> globalInitGridPoints;
+            localToGlobal->TransformPoints(localInitGridPoints, globalInitGridPoints);
+
+            for (vtkIdType i = 0; i < localInitGridPoints->GetNumberOfPoints(); ++i) {
+                double pInit[3], pTarget[3];
+                globalInitGridPoints->GetPoint(i, pInit);
+
+                initialPoints->InsertNextPoint(pInit);
+
+                if (outOriginMap) {
+                    outOriginMap->push_back(pid);
+                }
+            }
+        }
+    }
+
+    return initialPoints;
+}
+}  // namespace LegacyHandleExpansion
