+void DashHandlePickingInteraction::SetControlRegionOverlay(const std::vector<vtkIdType>& volumeIds,
+                                                           bool confirmed)
+{
+    m_controlRegionVolumeIds = { volumeIds.begin(), volumeIds.end() };
+    m_controlRegionConfirmed = confirmed;
+    UpdateControlRegionOverlay();
+}
+
+void DashHandlePickingInteraction::UpdateControlRegionOverlay()
+{
+    if (!m_surfaceGeometry) {
+        return;
+    }
+    auto* selections =
+        m_surfaceGeometry->GetPointData()->GetArray(HandleArrayNames::constraintsAndHandles);
+    auto* volumeIds = m_surfaceGeometry->GetPointData()->GetArray(HandleArrayNames::volumePointIds);
+    std::unordered_set<vtkIdType> fixedCells(m_nonDesignSurfaceIds.begin(),
+                                             m_nonDesignSurfaceIds.end());
+    fixedCells.insert(m_constraintSurfaceIds.begin(), m_constraintSurfaceIds.end());
+    vtkNew<vtkCellArray> faces;
+    for (vtkIdType c = 0; c < m_surfaceGeometry->GetNumberOfCells(); ++c) {
+        auto* cell = m_surfaceGeometry->GetCell(c);
+        if (cell->GetCellDimension() != 2 || fixedCells.contains(c)) {
+            continue;
+        }
+        bool marked = false;
+        bool fixed = false;
+        for (vtkIdType k = 0; k < cell->GetNumberOfPoints(); ++k) {
+            const auto id = cell->GetPointId(k);
+            const auto selection = selections ? selections->GetTuple1(id) : 0;
+            fixed = fixed || selection == 2;
+            // During painting use the live selection, including Shift-to-erase.
+            marked =
+                marked
+                || (m_currentMode == MODE_SURFACE ? selection == 3
+                                                  : volumeIds
+                                                        && m_controlRegionVolumeIds.contains(
+                                                            vtkIdType(volumeIds->GetTuple1(id))));
+        }
+        if (marked && !fixed) {
+            faces->InsertNextCell(cell->GetPointIds());
+        }
+    }
+    if (!m_controlRegionActor) {
+        auto* renderer = m_interactorStyle ? m_interactorStyle->GetCurrentRenderer() : nullptr;
+        if (!renderer) {
+            return;
+        }
+        m_controlRegionActor = vtkSmartPointer<vtkActor>::New();
+        vtkNew<vtkPolyDataMapper> mapper;
+        mapper->ScalarVisibilityOff();
+        mapper->SetResolveCoincidentTopologyToPolygonOffset();
+        mapper->SetRelativeCoincidentTopologyPolygonOffsetParameters(-1, -1);
+        m_controlRegionActor->SetMapper(mapper);
+        m_controlRegionActor->PickableOff();
+        m_controlRegionActor->GetProperty()->SetColor(0.15, 0.4, 1.0);
+        m_controlRegionActor->GetProperty()->LightingOff();
+        m_controlRegionActor->GetProperty()->EdgeVisibilityOff();
+        renderer->AddActor(m_controlRegionActor);
+    }
+    vtkNew<vtkPolyData> overlay;
+    overlay->SetPoints(m_surfaceGeometry->GetPoints());
+    overlay->SetPolys(faces);
+    vtkPolyDataMapper::SafeDownCast(m_controlRegionActor->GetMapper())->SetInputData(overlay);
+    m_controlRegionActor->GetProperty()->SetOpacity(
+        m_controlRegionConfirmed && m_currentMode != MODE_SURFACE ? 0.15 : 0.35);
+    m_controlRegionActor->SetVisibility(m_regionOverlaysVisible && faces->GetNumberOfCells() > 0);
+}
