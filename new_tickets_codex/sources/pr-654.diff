+void DashHandleVisualizer::UpdateSampledHandles(std::span<const DashHandleEntry> entries)
+{
+    std::array<vtkSmartPointer<vtkPoints>, 2> points{ vtkSmartPointer<vtkPoints>::New(),
+                                                      vtkSmartPointer<vtkPoints>::New() };
+    for (auto& p : points) {
+        p->SetDataTypeToDouble();
+    }
+    for (const auto& e : entries) {
+        if (!e.isSampled() && !e.isFixed()) {
+            continue;
+        }
+        auto block = DashHandleSets::block(e);
+        if (!block) {
+            continue;
+        }
+        for (const auto& p : block->positions) {
+            points[e.isFixed() ? 1 : 0]->InsertNextPoint(p.data());
+        }
+    }
+    for (int i = 0; i < 2; ++i) {
+        if (sampledPoints_[i]) {
+            sampledPoints_[i]->SetPoints(points[i]);
+        }
+        if (sampledActors_[i]) {
+            sampledActors_[i]->SetVisibility(geometry_ && points[i]->GetNumberOfPoints() > 0);
+        }
+    }
