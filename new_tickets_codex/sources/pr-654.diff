@@ -0,0 +1,90 @@
+#include <QtTest/QtTest>
+#include "controller/DashHandleSampling.h"
+#include "tests/TestLevel.h"
+namespace {
+DashHandleSampling::Input input(std::vector<std::array<double, 3>> points, double radius = 4.0)
+{
+    DashHandleSampling::Input out;
+    out.baseline.role = "design";
+    out.baseline.positions = std::move(points);
+    out.baseline.supportRadii.assign(out.baseline.size(), radius);
+    DashHandleMotion motion;
+    motion.displacements.assign(out.baseline.size(), { 1.0, 0.0, 0.0 });
+    out.fields.push_back(std::move(motion));
+    return out;
+}
+}  // namespace
+class TestHandleSampling : public QObject
+{
+    Q_OBJECT
+private slots:
+    void budgetAndDeterminism()
+    {
+        if (DashTestLevel::requestedLevel() < DashTestLevel::Level::Push) {
+            QSKIP("Level 2 sampling solver test");
+        }
+        std::vector<DashHandleSampling::Input> pinned{ input({ { -1, 0, 0 }, { 5, 4, 0 } }) };
+        std::vector<std::array<double, 3>> points;
+        for (int y = 0; y < 5; ++y) {
+            for (int x = 0; x < 5; ++x) {
+                points.push_back({ double(x), double(y), 0 });
+            }
+        }
+        std::vector<DashHandleSampling::Input> candidates{ input(points) };
+        DashHandleSamplingPolicy policy;
+        policy.maximumHandles = 8;
+        policy.solverThreads = 1;
+        auto a = DashHandleSampling::sample(pinned, candidates, policy);
+        QVERIFY(a.has_value());
+        QVERIFY(a->selection.size() <= policy.maximumHandles);
+        QCOMPARE(a->summary.sampledCount, a->selection.size());
+        auto b = DashHandleSampling::sample(pinned, candidates, policy);
+        QVERIFY(b.has_value());
+        QVERIFY(a->selection == b->selection);
+    }
+    void invalidInputs()
+    {
+        std::vector<DashHandleSampling::Input> pinned{ input({ { 0, 0, 0 }, { 1, 0, 0 } }) };
+        std::vector<DashHandleSampling::Input> candidates{ input({ { 2, 0, 0 } }) };
+        DashHandleSamplingPolicy policy;
+        policy.tolerance = 0;
+        auto badPolicy = DashHandleSampling::sample(pinned, candidates, policy);
+        QVERIFY(!badPolicy);
+        QCOMPARE(badPolicy.error().code(), dash::core::ErrorCode::InvalidArgument);
+        policy.tolerance = 1e-3;
+        auto emptyCandidates = DashHandleSampling::sample(pinned, {}, policy);
+        QVERIFY(!emptyCandidates);
+        QCOMPARE(emptyCandidates.error().code(), dash::core::ErrorCode::InvalidArgument);
+        pinned = { input({ { 0, 0, 0 } }) };
+        auto onePinned = DashHandleSampling::sample(pinned, candidates, policy);
+        QVERIFY(!onePinned);
+        QCOMPARE(onePinned.error().code(), dash::core::ErrorCode::InvalidArgument);
+    }
+    void coveredCandidatesAndIsolation()
+    {
+        if (DashTestLevel::requestedLevel() < DashTestLevel::Level::Push) {
+            QSKIP("Level 2 sampling solver test");
+        }
+        std::vector<DashHandleSampling::Input> pinned{ input({ { 0, 0, 0 }, { 1, 0, 0 } }, 0.1) };
+        std::vector<DashHandleSampling::Input> candidates{ input({ { 2, 0, 0 } }, 0.1) };
+        DashHandleSamplingPolicy policy;
+        policy.solverThreads = 1;
+        policy.allowIsolatedHandles = true;
+        QVERIFY(DashHandleSampling::sample(pinned, candidates, policy));
+        policy.allowIsolatedHandles = false;
+        QVERIFY(!DashHandleSampling::sample(pinned, candidates, policy));
+        // Zero fields are already represented: no candidate should be selected.
+        pinned = { input({ { 0, 0, 0 }, { 1, 0, 0 } }) };
+        candidates = { input({ { 0.5, 0, 0 } }) };
+        for (auto& p : pinned[0].fields[0].displacements) {
+            p = { 0, 0, 0 };
+        }
+        candidates[0].fields[0].displacements[0] = { 0, 0, 0 };
+        auto covered = DashHandleSampling::sample(pinned, candidates, policy);
+        QVERIFY(covered.has_value());
+        QVERIFY(covered->selection.empty());
+        QCOMPARE(covered->summary.outcome, DashSamplingSummary::Outcome::Converged);
+    }
+};
+QTEST_GUILESS_MAIN(TestHandleSampling)
+#include "TestHandleSampling.moc"
