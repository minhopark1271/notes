+bool writeOdbSourceSets(const QString& configPath, const QStringList& setNames)
+{
+    if (configPath.isEmpty()) {
+        DASH_LOG_WARN(DataProcessor) << "writeOdbSourceSets: config path is empty";
+        return false;
+    }
+    auto existingRoot = readRoot(configPath);
+    if (!existingRoot) {
+        return false;
+    }
+    QJsonObject root = std::move(*existingRoot);
+    root[kOdbSourceSets] = QJsonArray::fromStringList(setNames);
+    return writeRoot(configPath, root);
+}
+
+std::optional<QStringList> readOdbSourceSets(const QString& configPath)
+{
+    const QJsonObject root = readExisting(configPath);
+    if (!root.contains(kOdbSourceSets)) {
+        return std::nullopt;
+    }
+    QStringList setNames;
+    for (const QJsonValue& value : root.value(kOdbSourceSets).toArray()) {
+        setNames.append(value.toString());
+    }
+    return setNames;
+}
+
 }  // namespace DashAnalysisLauncherConfig
