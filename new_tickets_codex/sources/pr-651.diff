diff --git a/model/preprocessor/DashFeSafeOdbSources.h b/model/preprocessor/DashFeSafeOdbSources.h
new file mode 100644
index 00000000..18785379
--- /dev/null
+++ b/model/preprocessor/DashFeSafeOdbSources.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <QDir>
+#include <QFileInfo>
+#include <QString>
+#include <QStringList>
+#include <optional>
+
+// fe-safe's ODB sources (#616): a .stli Set reads, per case, the ODB that other Analysis
+// Launcher Sets (pinned to an .inp) produced for the same DOE Sampler Set and run key. Pure —
+// the caller resolves the module directories; Qt Core only.
+namespace DashFeSafeOdbSources {
+
+// The sources in effect: candidates in their order, limited to the saved choice. Nothing saved
+// (nullopt) means every candidate; a saved name that is no longer a candidate is dropped.
+inline QStringList selectedSets(const QStringList& candidates,
+                                const std::optional<QStringList>& saved)
+{
+    if (!saved) {
+        return candidates;
+    }
+    QStringList selected;
+    for (const QString& name : candidates) {
+        if (saved->contains(name)) {
+            selected.append(name);
+        }
+    }
+    return selected;
+}
+
+// <sourceModuleDir>/<doeSamplerSet>/<runKey>/<runKey>.odb — where the source Set's Abaqus run
+// left its ODB
+inline QString sourceOdbPath(const QString& sourceModuleDir,
+                             const QString& doeSamplerSet,
+                             const QString& runKey)
+{
+    return QDir::toNativeSeparators(
+        QDir(sourceModuleDir).filePath(doeSamplerSet + '/' + runKey + '/' + runKey + ".odb"));
+}
+
+// <inp base name>.odb — the name the fe-safe template expects the source's ODB under
+inline QString destinationOdbName(const QString& inpPath)
+{
+    return QFileInfo(inpPath).completeBaseName() + QLatin1String(".odb");
+}
+
+}  // namespace DashFeSafeOdbSources
