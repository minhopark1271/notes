+// Unit test for model/preprocessor/DashFeSafeOdbSources (#616) — which Analysis Launcher Sets
+// fe-safe reads, where their ODB is and the name it gets in the fe-safe run folder.
+
+#include <QtTest/QtTest>
+
+#include "model/preprocessor/DashFeSafeOdbSources.h"
+
+class TestFeSafeOdbSources : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void nothingSavedSelectsEveryCandidate();
+    void savedChoiceKeepsCandidateOrder();
+    void emptyChoiceSelectsNothing();
+    void sourceOdbIsTheRunKeysOdbUnderTheDoeSamplerSet();
+    void destinationIsNamedAfterTheInp();
+};
+
+void TestFeSafeOdbSources::nothingSavedSelectsEveryCandidate()
+{
+    const QStringList candidates{ "A_inp", "B_inp" };
+    QCOMPARE(DashFeSafeOdbSources::selectedSets(candidates, std::nullopt), candidates);
+}
+
+void TestFeSafeOdbSources::savedChoiceKeepsCandidateOrder()
+{
+    // A saved name that is no longer a candidate (deleted or re-pinned Set) is dropped.
+    const QStringList candidates{ "A_inp", "B_inp", "C_inp" };
+    const std::optional<QStringList> saved = QStringList{ "C_inp", "gone_inp", "A_inp" };
+    QCOMPARE(DashFeSafeOdbSources::selectedSets(candidates, saved),
+             (QStringList{ "A_inp", "C_inp" }));
+}
+
+void TestFeSafeOdbSources::emptyChoiceSelectsNothing()
+{
+    const std::optional<QStringList> saved = QStringList{};
+    QVERIFY(DashFeSafeOdbSources::selectedSets({ "A_inp" }, saved).isEmpty());
+}
+
+void TestFeSafeOdbSources::sourceOdbIsTheRunKeysOdbUnderTheDoeSamplerSet()
+{
+    QCOMPARE(DashFeSafeOdbSources::sourceOdbPath("C:/prj/AnalysisLauncher_A_inp", "Doe1", "runs3"),
+             QDir::toNativeSeparators("C:/prj/AnalysisLauncher_A_inp/Doe1/runs3/runs3.odb"));
+}
+
+void TestFeSafeOdbSources::destinationIsNamedAfterTheInp()
+{
+    QCOMPARE(DashFeSafeOdbSources::destinationOdbName("models/A.inp"), QString("A.odb"));
+    QCOMPARE(DashFeSafeOdbSources::destinationOdbName("bracket.v2.inp"), QString("bracket.v2.odb"));
+}
+
+QTEST_GUILESS_MAIN(TestFeSafeOdbSources)
+#include "TestFeSafeOdbSources.moc"
