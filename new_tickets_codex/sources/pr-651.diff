+void DashAnalysisLauncherWidget::setTargetPartCheckable(bool checkable)
+{
+    m_targetPartIsOdbSources = checkable;
+    ui->launcherTargetPartLabel->setText(checkable ? tr("ODB Source Sets") : tr("Target Part"));
+    // Editable so the closed combo can show a summary; NoInsert keeps Enter from adding it as a
+    // row. setEditable(false) drops the line edit and the next setEditable(true) makes a new one,
+    // so the filter goes on each time.
+    m_targetPartCombo->setEditable(checkable);
+    if (!checkable) {
+        return;
+    }
+    m_targetPartCombo->setInsertPolicy(QComboBox::NoInsert);
+    m_targetPartCombo->lineEdit()->setReadOnly(true);
+    m_targetPartCombo->lineEdit()->setPlaceholderText(tr("Select ODB Source Sets"));
+    m_targetPartCombo->lineEdit()->installEventFilter(this);
+}
+
+void DashAnalysisLauncherWidget::fillOdbSourceSets(DashAnalysisLauncher* model)
+{
+    // Only .inp Sets run Abaqus and leave an ODB; the .stli Set itself is never one of them.
+    const QStringList candidates =
+        DashProjectManager::Instance()->GetProject()->inpAnalysisLauncherSources().keys();
+    const QStringList checked =
+        DashFeSafeOdbSources::selectedSets(candidates, model->odbSourceSets());
+    for (const QString& setName : candidates) {
+        auto* item = new QStandardItem(setName);
+        item->setFlags(Qt::ItemIsUserCheckable | Qt::ItemIsEnabled);
+        item->setCheckState(checked.contains(setName) ? Qt::Checked : Qt::Unchecked);
+        m_targetPartModel->appendRow(item);
+    }
+    m_targetPartCombo->setEnabled(!candidates.isEmpty());
+    syncOdbSourceSummary();
+}
+
+QStringList DashAnalysisLauncherWidget::checkedOdbSourceSets() const
+{
+    QStringList sets;
+    for (int row = 0; row < m_targetPartModel->rowCount(); ++row) {
+        const QStandardItem* item = m_targetPartModel->item(row);
+        if (item->checkState() == Qt::Checked) {
+            sets.append(item->text());
+        }
+    }
+    return sets;
+}
+
+void DashAnalysisLauncherWidget::syncOdbSourceSummary()
+{
+    const int count = checkedOdbSourceSets().size();
+    m_targetPartCombo->lineEdit()->setText(
+        count == 0 ? QString() : tr("%1 Set%2 selected").arg(count).arg(count == 1 ? "" : "s"));
+}
+
+bool DashAnalysisLauncherWidget::eventFilter(QObject* watched, QEvent* event)
+{
+    if (!m_targetPartIsOdbSources || event->type() != QEvent::MouseButtonRelease) {
+        return QWidget::eventFilter(watched, event);
+    }
+    // An editable combo does not open its popup on a click in the text area.
+    if (watched == m_targetPartCombo->lineEdit()) {
+        if (!m_targetPartCombo->view()->isVisible()) {
+            m_targetPartCombo->showPopup();
+        }
+        return true;
+    }
+    if (watched == m_targetPartCombo->view()->viewport()) {
+        const QModelIndex index =
+            m_targetPartCombo->view()->indexAt(static_cast<QMouseEvent*>(event)->pos());
+        if (index.isValid()) {
+            QStandardItem* item = m_targetPartModel->itemFromIndex(index);
+            item->setCheckState(item->checkState() == Qt::Checked ? Qt::Unchecked : Qt::Checked);
+        }
+        return true;  // the popup stays open to pick several Sets in a row
+    }
+    return QWidget::eventFilter(watched, event);
+}
