diff --git a/model/DashReferenceSetName.h b/model/DashReferenceSetName.h
index 47e93943..07ae1b90 100644
--- a/model/DashReferenceSetName.h
+++ b/model/DashReferenceSetName.h
@@ -1,8 +1,58 @@
 #pragma once
 
+#include <QDir>
 #include <QFileInfo>
 #include <QString>
 
+// Kind of a reference file, decided by its suffix (#616). Only Inp/Dat are read by RW;
+// the rest are registered and copied as-is and get an Analysis Launcher Set only.
+namespace DashReferenceKind {
+
+enum Kind
+{
+    Inp,
+    Dat,
+    Dfsxml,
+    Wbpj,
+    Stli,
+    Unknown
+};
+
+inline Kind fromPath(const QString& referencePath)
+{
+    const QString suffix = QFileInfo(referencePath).suffix().toLower();
+    if (suffix == QLatin1String("inp")) {
+        return Inp;
+    }
+    if (suffix == QLatin1String("dat")) {
+        return Dat;
+    }
+    if (suffix == QLatin1String("dfsxml")) {
+        return Dfsxml;
+    }
+    if (suffix == QLatin1String("wbpj")) {
+        return Wbpj;
+    }
+    if (suffix == QLatin1String("stli")) {
+        return Stli;
+    }
+    return Unknown;
+}
+
+inline bool isRwReadable(Kind kind)
+{
+    return kind == Inp || kind == Dat;
+}
+
+// Workbench keeps a project's data in the sibling "<name>_files" folder; the name keeps every
+// dot of the .wbpj's base name.
+inline QString wbpjFilesFolderName(const QString& wbpjPath)
+{
+    return QFileInfo(wbpjPath).completeBaseName() + QLatin1String("_files");
+}
+
+}  // namespace DashReferenceKind
+
 // Name of the Condition / Analysis Launcher Set pair created for a reference file (#603).
 // Every '.' becomes '_': DV display names are "<SetName>.<key>", and the Set's json file
 // name is split on its first dot when the project is restored.
@@ -10,7 +60,13 @@ namespace DashReferenceSetName {
 
 inline QString fromReferencePath(const QString& referencePath)
 {
-    return QFileInfo(referencePath).fileName().replace(QLatin1Char('.'), QLatin1Char('_'));
+    // A .stli belongs to its whole folder, so the Set is named after the folder (#616).
+    const QFileInfo info(referencePath);
+    if (DashReferenceKind::fromPath(referencePath) == DashReferenceKind::Stli) {
+        return info.dir().dirName().replace(QLatin1Char('.'), QLatin1Char('_'))
+               + QLatin1String("_stli");
+    }
+    return info.fileName().replace(QLatin1Char('.'), QLatin1Char('_'));
 }
 
 }  // namespace DashReferenceSetName
